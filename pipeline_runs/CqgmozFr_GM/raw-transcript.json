{
  "video_id": "CqgmozFr_GM",
  "url": "https://www.youtube.com/watch?v=CqgmozFr_GM",
  "title": "Long-Form Lecture",
  "duration_seconds": 242,
  "language": "en",
  "retrieved_at": "2026-09-01T10:06:40.885Z",
  "transcript_type": "OFFICIAL",
  "segments": [
    {
      "id": "seg-0001",
      "start": 0,
      "end": 7,
      "duration": 7,
      "text": "المترجم: Hanan Abu Rashed\nالمدقّق: Nada Qanbar"
    },
    {
      "id": "seg-0002",
      "start": 6.83,
      "end": 10.49,
      "duration": 3.66,
      "text": "لاعبك الرياضي المُفضّل قريب \nمن لحظة النصر الحاسمة."
    },
    {
      "id": "seg-0003",
      "start": 10.49,
      "end": 12.3,
      "duration": 1.81,
      "text": "تحبس الحشود أنفاسها،"
    },
    {
      "id": "seg-0004",
      "start": 12.3,
      "end": 15.66,
      "duration": 3.36,
      "text": "وفي اللحظة الحاسمة، تضيع فرصة النصر."
    },
    {
      "id": "seg-0005",
      "start": 15.66,
      "end": 19.47,
      "duration": 3.81,
      "text": "هذا المتنافس اختبر للتو\nالظاهرة المسماة \"الاختناق\""
    },
    {
      "id": "seg-0006",
      "start": 19.46,
      "end": 22.22,
      "duration": 2.76,
      "text": "حيث بالرغم من الشهور، \nأو حتى سنوات من التدريب،"
    },
    {
      "id": "seg-0007",
      "start": 22.23,
      "end": 24.97,
      "duration": 2.74,
      "text": "يفشل الشخص حينما \nيكون الأمر في غاية الأهمية."
    },
    {
      "id": "seg-0008",
      "start": 24.96,
      "end": 26.59,
      "duration": 1.63,
      "text": "الاختناق أمر شائع في الرياضة،"
    },
    {
      "id": "seg-0009",
      "start": 26.59,
      "end": 29.71,
      "duration": 3.12,
      "text": "حيث يتم الانجاز عادةً\nتحت الضغظ الشديد"
    },
    {
      "id": "seg-0010",
      "start": 29.71,
      "end": 31.57,
      "duration": 1.86,
      "text": "ويعتمد على لحظات مهمة."
    },
    {
      "id": "seg-0011",
      "start": 31.57,
      "end": 35.54,
      "duration": 3.97,
      "text": "وتصيب حالة ضغط الانجاز\nالمتحدثين أمام الجمهور"
    },
    {
      "id": "seg-0012",
      "start": 35.54,
      "end": 37.46,
      "duration": 1.92,
      "text": "المتنافسين في مسابقات التهجئة،"
    },
    {
      "id": "seg-0013",
      "start": 37.46,
      "end": 39.75,
      "duration": 2.29,
      "text": "وحتى الموسيقيين العالميين المشهورين أيضاً."
    },
    {
      "id": "seg-0014",
      "start": 39.75,
      "end": 42.8,
      "duration": 3.05,
      "text": "يضع معظم الناس اللوم \nعلى أعصابهم لهذه الحالة."
    },
    {
      "id": "seg-0015",
      "start": 42.8,
      "end": 46.89,
      "duration": 4.09,
      "text": "ولكن لماذا تسبب الحالة العصبية\nضعفاً عند أصحاب الأداء العالي؟"
    },
    {
      "id": "seg-0016",
      "start": 46.89,
      "end": 48.69,
      "duration": 1.8,
      "text": "هناك مجموعتان من النظريات لتفسير ذلك،"
    },
    {
      "id": "seg-0017",
      "start": 48.69,
      "end": 54.27,
      "duration": 5.58,
      "text": "حيث تقول كلاهما أن الاختناق\nتحت الضغط يتلخص في التركيز."
    },
    {
      "id": "seg-0018",
      "start": 54.27,
      "end": 57.15,
      "duration": 2.88,
      "text": "أولاً، هناك نظريات الإلهاء."
    },
    {
      "id": "seg-0019",
      "start": 57.15,
      "end": 60.74,
      "duration": 3.59,
      "text": "وهذه تقترح أن الأداء يتأثر\nحينما يكون الذهن مشغولاً"
    },
    {
      "id": "seg-0020",
      "start": 60.74,
      "end": 62.85,
      "duration": 2.11,
      "text": "بالأمور المُقلقة، الشكوك، أو المخاوف،"
    },
    {
      "id": "seg-0021",
      "start": 62.85,
      "end": 67.68,
      "duration": 4.83,
      "text": "بدلاً من تركيز اهتمامه على المهمة\nالتي يجب انجازها عملياً."
    },
    {
      "id": "seg-0022",
      "start": 67.68,
      "end": 71.14,
      "duration": 3.46,
      "text": "عندما تتنافس الأفكار المرتبطة بالأمر \nمع غير المرتبطة على نفس النقطة"
    },
    {
      "id": "seg-0023",
      "start": 71.14,
      "end": 73.19,
      "duration": 2.05,
      "text": "على إحداها أن تتنحى جانباً."
    },
    {
      "id": "seg-0024",
      "start": 73.19,
      "end": 76.69,
      "duration": 3.5,
      "text": "يستطيع الدماغ أن يعالج مجموعة \nواحدة من المعلومات في وقت واحد."
    },
    {
      "id": "seg-0025",
      "start": 76.69,
      "end": 78.79,
      "duration": 2.1,
      "text": "المهام التي تتحدى ذاكرة الإنسان،"
    },
    {
      "id": "seg-0026",
      "start": 78.79,
      "end": 80.68,
      "duration": 1.89,
      "text": "\"دفتر المذكرات\" العقلية الذي نستخدمه"
    },
    {
      "id": "seg-0027",
      "start": 80.68,
      "end": 83.78,
      "duration": 3.1,
      "text": "مؤقتاً لتخزين أرقام الهاتف وقوائم الشراء،"
    },
    {
      "id": "seg-0028",
      "start": 83.78,
      "end": 86.9,
      "duration": 3.12,
      "text": "معرض للعطب تحت الضغط."
    },
    {
      "id": "seg-0029",
      "start": 86.89,
      "end": 90.32,
      "duration": 3.43,
      "text": "في عام 2004، أجريت دراسة \nعلى مجموعة من طلاب جامعة"
    },
    {
      "id": "seg-0030",
      "start": 90.33,
      "end": 92.22,
      "duration": 1.89,
      "text": "طُلب منهم حل مسائل رياضية،"
    },
    {
      "id": "seg-0031",
      "start": 92.22,
      "end": 96.19,
      "duration": 3.97,
      "text": "بعضها سهل، وبعضها الآخر\nمعقد ويحتاج إلى ذاكرة كبيرة."
    },
    {
      "id": "seg-0032",
      "start": 96.19,
      "end": 100.64,
      "duration": 4.45,
      "text": "أنجز نصف الطلاب كلا \nالمهمتين بدون أي ملاحظات"
    },
    {
      "id": "seg-0033",
      "start": 100.64,
      "end": 104.99,
      "duration": 4.35,
      "text": "أما البقية فأنجزوا المهمتين \nبهدوء وتحت الضغط."
    },
    {
      "id": "seg-0034",
      "start": 104.99,
      "end": 107.53,
      "duration": 2.54,
      "text": "بينما أنجز الجميع المهمات\nالسهلة بشكل جيد،"
    },
    {
      "id": "seg-0035",
      "start": 107.53,
      "end": 109.58,
      "duration": 2.05,
      "text": "كان الانجاز سيئاً بالنسبة \nلمن كانوا متوترين"
    },
    {
      "id": "seg-0036",
      "start": 109.58,
      "end": 112.39,
      "duration": 2.81,
      "text": "في المهمات المعقدة\nالتي تحتاج إلى ذاكرة كبيرة."
    },
    {
      "id": "seg-0037",
      "start": 112.39,
      "end": 116.44,
      "duration": 4.05,
      "text": "نظريات المراقبة المحددة\nشكلت المجموعة الثانية من التفسيرات"
    },
    {
      "id": "seg-0038",
      "start": 116.44,
      "end": 118.12,
      "duration": 1.68,
      "text": "لحالة الاختناق تحت الضغط."
    },
    {
      "id": "seg-0039",
      "start": 118.12,
      "end": 119.48,
      "duration": 1.36,
      "text": "حيث اهتموا كيف أن الضغط"
    },
    {
      "id": "seg-0040",
      "start": 119.47,
      "end": 123.18,
      "duration": 3.71,
      "text": "يجعل الناس يحللون المهمات \nالعملية بتفصيل كبير."
    },
    {
      "id": "seg-0041",
      "start": 123.18,
      "end": 126.71,
      "duration": 3.53,
      "text": "هنا، يثبت المنطق أن المهارة \nكلما اتخذت صفة الاتوماتيكية"
    },
    {
      "id": "seg-0042",
      "start": 126.71,
      "end": 131.34,
      "duration": 4.63,
      "text": "كلما زادت القدرة على تنفيذها بشكل أدق."
    },
    {
      "id": "seg-0043",
      "start": 131.34,
      "end": 136.65,
      "duration": 5.31,
      "text": "إن المهام التي ننفذها بشكل تلقائي\nبعيدة عن هذا النوع من حالات الاختناق."
    },
    {
      "id": "seg-0044",
      "start": 136.66,
      "end": 140.01,
      "duration": 3.35,
      "text": "في دراسة أجريت \nعلى متنافسي الغولف لمقارنة أدائهم"
    },
    {
      "id": "seg-0045",
      "start": 140.01,
      "end": 143.94,
      "duration": 3.93,
      "text": "حينما يكون تركيزهم فقط \nعلى وضع الكرة في الهدف"
    },
    {
      "id": "seg-0046",
      "start": 143.94,
      "end": 146.88,
      "duration": 2.94,
      "text": "مقابل أن يستعدوا تماماً ويفكروا بشكل دقيق"
    },
    {
      "id": "seg-0047",
      "start": 146.88,
      "end": 149.33,
      "duration": 2.45,
      "text": "بالميكانيكية التي سيتبعونها لضربتهم."
    },
    {
      "id": "seg-0048",
      "start": 149.33,
      "end": 152.47,
      "duration": 3.14,
      "text": "عادةً ما يؤدي لاعبو الغولف \nضرباتهم بشكل لا شعوري"
    },
    {
      "id": "seg-0049",
      "start": 152.47,
      "end": 156.55,
      "duration": 4.08,
      "text": "لذلك، أولئك الذين يفكرون بشكل\nتفصيلي في حركاتهم"
    },
    {
      "id": "seg-0050",
      "start": 156.55,
      "end": 159.92,
      "duration": 3.37,
      "text": "يصبحون أسوأ في تنفيذ ضربات أدق."
    },
    {
      "id": "seg-0051",
      "start": 159.91,
      "end": 162.79,
      "duration": 2.88,
      "text": "إن حالة الاختناق قد لا تكون\nحالة حتمية للجميع."
    },
    {
      "id": "seg-0052",
      "start": 162.79,
      "end": 166.17,
      "duration": 3.38,
      "text": "ترى الأبحاث أن البعض أكثر\nعرضة للإصابة بالحالة من الآخرين،"
    },
    {
      "id": "seg-0053",
      "start": 166.17,
      "end": 168.17,
      "duration": 2,
      "text": "خصوصاً أولئك الذين يملكون وعياً للذات"
    },
    {
      "id": "seg-0054",
      "start": 168.17,
      "end": 169.23,
      "duration": 1.06,
      "text": "والقلقون"
    },
    {
      "id": "seg-0055",
      "start": 169.22,
      "end": 172.09,
      "duration": 2.87,
      "text": "ويخافون من التعرض للحكم\nالسيىء من قبل الآخرين."
    },
    {
      "id": "seg-0056",
      "start": 172.09,
      "end": 175.38,
      "duration": 3.29,
      "text": "إذاً، كيف يمكن تجنب حالة \nالاختناق عندما يكون الأمر مهماً؟"
    },
    {
      "id": "seg-0057",
      "start": 175.39,
      "end": 178.93,
      "duration": 3.54,
      "text": "أولاً، من المهم التدريب تحت الضغط."
    },
    {
      "id": "seg-0058",
      "start": 178.93,
      "end": 181.14,
      "duration": 2.21,
      "text": "في دراسة أجريت على لاعبي\nرمي السهام المحترفين"
    },
    {
      "id": "seg-0059",
      "start": 181.14,
      "end": 184.76,
      "duration": 3.62,
      "text": "وجد الباحثون أن أولئك \nالذين لم يتدربوا تحت الضغط"
    },
    {
      "id": "seg-0060",
      "start": 184.76,
      "end": 186.7,
      "duration": 1.94,
      "text": "كان أداؤهم أسوأ عند القلق"
    },
    {
      "id": "seg-0061",
      "start": 186.69,
      "end": 190.14,
      "duration": 3.45,
      "text": "بالمقارنة مع أولئك الذين أصبحوا \nمتعودين على الأداء تحت الضغط"
    },
    {
      "id": "seg-0062",
      "start": 190.15,
      "end": 195.12,
      "duration": 4.97,
      "text": "ثانياً، يمجد الكثيرون مزايا إجراء بعض \nالحركات الروتينية قبل الأداء"
    },
    {
      "id": "seg-0063",
      "start": 195.12,
      "end": 197.51,
      "duration": 2.39,
      "text": "كأخذ نفس عميق،"
    },
    {
      "id": "seg-0064",
      "start": 197.51,
      "end": 199.06,
      "duration": 1.55,
      "text": "وتكرار مجموعة من الكلمات،"
    },
    {
      "id": "seg-0065",
      "start": 199.06,
      "end": 201.8,
      "duration": 2.74,
      "text": "أو أداء مجموعة من الحركات\nذات التسلسل الإيقاعي."
    },
    {
      "id": "seg-0066",
      "start": 201.8,
      "end": 204.56,
      "duration": 2.76,
      "text": "الدراسات التي أجريت على لعبة \nالغولف، البولينغ، وكرة الماء"
    },
    {
      "id": "seg-0067",
      "start": 204.56,
      "end": 207.89,
      "duration": 3.33,
      "text": "وجدت أن الطقوس القصيرة تؤدي\nإلى مزيد من حالة التناغم"
    },
    {
      "id": "seg-0068",
      "start": 207.89,
      "end": 210.22,
      "duration": 2.33,
      "text": "وتضبط الأداء تحت الضغط."
    },
    {
      "id": "seg-0069",
      "start": 210.22,
      "end": 212,
      "duration": 1.78,
      "text": "وثالثاً، أظهر الباحثون"
    },
    {
      "id": "seg-0070",
      "start": 212,
      "end": 215.23,
      "duration": 3.23,
      "text": "أن التركيز الخارجي على الهدف النهائي"
    },
    {
      "id": "seg-0071",
      "start": 215.23,
      "end": 217.54,
      "duration": 2.31,
      "text": "يعمل بشكل أفضل من التركيز الداخلي"
    },
    {
      "id": "seg-0072",
      "start": 217.54,
      "end": 221.17,
      "duration": 3.63,
      "text": "حيث أن الفرد يُضبط على الآلية \nلما يقوم بفعله"
    },
    {
      "id": "seg-0073",
      "start": 221.17,
      "end": 224.93,
      "duration": 3.76,
      "text": "كشفت دراسة على لاعبي الغولف المحترفين\nأن أولئك الذين ينفذون ضربات رقيقة"
    },
    {
      "id": "seg-0074",
      "start": 224.93,
      "end": 227.04,
      "duration": 2.11,
      "text": "ويركزون على الكرة أثناء طيرانها"
    },
    {
      "id": "seg-0075",
      "start": 227.04,
      "end": 231.46,
      "duration": 4.42,
      "text": "يكون أداؤهم أفضل بكثير من أولئك \nالذين يركزون على حركات الذراعين"
    },
    {
      "id": "seg-0076",
      "start": 231.46,
      "end": 234.59,
      "duration": 3.13,
      "text": "لذلك، ربما عدّلنا على القول القديم:"
    },
    {
      "id": "seg-0077",
      "start": 234.59,
      "end": 235.42,
      "duration": 0.83,
      "text": "التدريب،"
    },
    {
      "id": "seg-0078",
      "start": 235.42,
      "end": 236.43,
      "duration": 1.01,
      "text": "تحت الضغط،"
    },
    {
      "id": "seg-0079",
      "start": 236.43,
      "end": 237.79,
      "duration": 1.36,
      "text": "مع التركيز،"
    },
    {
      "id": "seg-0080",
      "start": 237.79,
      "end": 240.21,
      "duration": 2.42,
      "text": "مع ذلك الهدف النهائي المتألق في الأفق"
    },
    {
      "id": "seg-0081",
      "start": 240.21,
      "end": 241.75,
      "duration": 1.54,
      "text": "سيكون مثالياً."
    }
  ]
}