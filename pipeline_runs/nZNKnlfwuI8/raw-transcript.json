      "duration": 4.28,
      "text": "these are bad decisions individually."
    },
    {
      "id": "seg-0070",
      "start": 148.56,
      "end": 153.6,
      "duration": 5.04,
      "text": "All of them stacked on top of each other"
    },
    {
      "id": "seg-0071",
      "start": 150.68,
      "end": 156.12,
      "duration": 5.44,
      "text": "year after year quietly add up to a life"
    },
    {
      "id": "seg-0072",
      "start": 153.6,
      "end": 158.32,
      "duration": 4.72,
      "text": "where nothing unexpected ever gets in."
    },
    {
      "id": "seg-0073",
      "start": 156.12,
      "end": 161.44,
      "duration": 5.32,
      "text": "Bourdain spent his 30s doing exactly"
    },
    {
      "id": "seg-0074",
      "start": 158.32,
      "end": 163.48,
      "duration": 5.16,
      "text": "this. Good at his job. Had a title. Had"
