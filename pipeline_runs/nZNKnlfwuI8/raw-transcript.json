      "text": "eating everything, talking to everyone."
    },
    {
      "id": "seg-0030",
      "start": 64.08,
      "end": 67.8,
      "duration": 3.72,
      "text": "A career that traced back entirely to"
    },
    {
      "id": "seg-0031",
