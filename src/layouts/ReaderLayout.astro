---
import ThemeController from '../components/ThemeController.astro';
import CurriculumDrawer from '../components/CurriculumDrawer.astro';
import SearchModal from '../components/SearchModal.astro';
import ProgressBar from '../components/ProgressBar.astro';
import { getCollection } from 'astro:content';
import { getVolumeGroups } from '../utils/navigation';
import '../styles/reader.css';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  currentVolume?: number;
  isWideLayout?: boolean;
  isVolumeLayout?: boolean;
  hideNavSearch?: boolean;
  isSearchIndexed?: boolean;
}

const { 
  title, 
  description = 'The Living Codex — Master Knowledge Base', 
  currentSlug = '', 
  currentVolume,
  isWideLayout = false,
  isVolumeLayout = false,
  hideNavSearch = false,
  isSearchIndexed = true
} = Astro.props;

const allTopics = await getCollection('topics');
const allVolumes = getVolumeGroups(allTopics);
---

<!DOCTYPE html>
<html lang="en" data-theme="sepia">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — The Living Codex</title>
  <meta name="description" content={description} />
  
  <!-- Kindle-Grade Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- KaTeX CSS for LaTeX Mathematical Notation -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />

  <!-- Mermaid.js for Client-Side Diagram Rendering -->
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js" is:inline></script>
  <script is:inline>
    function getMermaidTheme(theme) {
      if (theme === 'dark' || theme === 'oled') return 'dark';
      if (theme === 'paper') return 'default';
      return 'neutral'; // warm sepia
    }

    async function renderMermaidDiagrams() {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'sepia';
      const mTheme = getMermaidTheme(currentTheme);

      if (window.mermaid) {
        window.mermaid.initialize({
          startOnLoad: false,
          theme: mTheme,
          securityLevel: 'loose',
          fontFamily: 'Inter, sans-serif',
          fontSize: 14,
          flowchart: {
            useMaxWidth: true,
            htmlLabels: true,
            curve: 'basis',
            nodeSpacing: 40,
            rankSpacing: 45
          }
        });

        document.querySelectorAll('pre > code.language-mermaid, pre.astro-code[data-language="mermaid"]').forEach((codeEl) => {
          const preEl = codeEl.tagName === 'PRE' ? codeEl : codeEl.parentElement;
          const diagramCode = codeEl.textContent || '';
          const div = document.createElement('div');
          div.className = 'mermaid-diagram-wrapper';
          div.setAttribute('data-mermaid-code', diagramCode);
          div.setAttribute('data-zoom', '100');
          div.innerHTML = `
            <div class="mermaid-toolbar">
              <span class="mermaid-label">📐 Concept Schema</span>
              <div class="mermaid-zoom-actions">
                <button type="button" class="m-zoom-btn m-zoom-out" title="Zoom Out Diagram">🔍−</button>
                <button type="button" class="m-zoom-btn m-zoom-reset" title="Reset Diagram Size">100%</button>
                <button type="button" class="m-zoom-btn m-zoom-in" title="Zoom In Diagram">🔍+</button>
                <button type="button" class="m-zoom-btn m-zoom-fit" title="Expand Diagram to 100% Full Width">⛶ Full</button>
              </div>
            </div>
            <div class="mermaid-viewport"><pre class="mermaid">${diagramCode}</pre></div>
          `;
          if (preEl && preEl.parentNode) {
            preEl.parentNode.replaceChild(div, preEl);
          }
        });

        document.querySelectorAll('.mermaid-diagram-wrapper').forEach((wrapper) => {
          const rawCode = wrapper.getAttribute('data-mermaid-code') || '';
          const viewport = wrapper.querySelector('.mermaid-viewport');
          if (rawCode && viewport) {
            viewport.innerHTML = `<pre class="mermaid">${rawCode}</pre>`;
          }
        });

        try {
          await window.mermaid.run({
            querySelector: '.mermaid'
          });

          // Proportional scaling: narrow diagrams stay compact, wide diagrams scale responsively
          document.querySelectorAll('.mermaid-diagram-wrapper svg').forEach((svg) => {
            const viewBox = svg.getAttribute('viewBox');
          // Setup Interactive Zoom & Fit Controls for each diagram
          document.querySelectorAll('.mermaid-diagram-wrapper').forEach((wrapper) => {
            const svg = wrapper.querySelector('svg');
            if (!svg) return;

            let currentZoom = 100;
            const resetBtn = wrapper.querySelector('.m-zoom-reset');
            const inBtn = wrapper.querySelector('.m-zoom-in');
            const outBtn = wrapper.querySelector('.m-zoom-out');
            const fitBtn = wrapper.querySelector('.m-zoom-fit');

            function applyZoom(z) {
              currentZoom = Math.max(50, Math.min(250, z));
              svg.style.transform = `scale(${currentZoom / 100})`;
              svg.style.transformOrigin = 'center top';
              if (resetBtn) resetBtn.textContent = `${currentZoom}%`;
            }

            if (inBtn) inBtn.onclick = () => applyZoom(currentZoom + 15);
            if (outBtn) outBtn.onclick = () => applyZoom(currentZoom - 15);
            if (resetBtn) resetBtn.onclick = () => applyZoom(100);
            if (fitBtn) fitBtn.onclick = () => {
              if (svg.style.maxWidth === 'none' || svg.style.width === '100%') {
                svg.style.maxWidth = '100%';
                svg.style.width = 'auto';
                applyZoom(100);
                fitBtn.textContent = '⛶ Full';
              } else {
                svg.style.maxWidth = 'none';
                svg.style.width = '100%';
                applyZoom(120);
                fitBtn.textContent = '↩ Normal';
              }
            };
          });
        } catch (err) {
          console.warn('Mermaid rendering notice:', err);
        }
      }
    }

    document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
    window.addEventListener('theme-changed', renderMermaidDiagrams);
  </script>

  <!-- Track Last Read Topic for Continue Reading Section -->
  {currentSlug && (
    <script is:inline define:vars={{ currentSlug, title, description }}>
      try {
        localStorage.setItem('codex-last-read', JSON.stringify({
          slug: currentSlug,
          title: title,
          summary: description,
          timestamp: Date.now()
        }));
      } catch (_) {}
    </script>
  )}
</head>
<body>
  <ProgressBar />

  <CurriculumDrawer currentSlug={currentSlug} currentVolume={currentVolume} allVolumes={allVolumes} />
  <SearchModal />

  <header class="top-nav">
    <div class="nav-left">
      <button id="drawer-toggle-btn" class="drawer-toggle-btn" aria-label="Open Curriculum Drawer" title="Toggle Curriculum (Press \)">
        <span aria-hidden="true">☰</span>
        <span class="btn-text">Curriculum</span>
      </button>
      <a href="/ytdecoded/" class="brand-link">
        <span>The Living Codex</span>
      </a>
    </div>

    <div class="nav-right">
      {!hideNavSearch && (
        <button id="search-trigger-btn" class="search-trigger-btn" aria-label="Open Search (Press / or Cmd+K)" title="Search (Press /)">
          <span aria-hidden="true">🔍</span>
          <span class="btn-text">Search <kbd class="nav-kbd">/</kbd></span>
        </button>
      )}
      <ThemeController />
    </div>
  </header>

  <main 
    class={`reader-container ${isWideLayout ? 'wide-layout' : ''} ${isVolumeLayout ? 'volume-layout' : ''}`} 
    id="main-content" 
    {...(isSearchIndexed ? { 'data-pagefind-body': true } : { 'data-pagefind-ignore': true })}
  >
    <slot />
  </main>
</body>
</html>
