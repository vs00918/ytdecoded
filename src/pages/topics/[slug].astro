---
import { getCollection } from 'astro:content';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import DepthSlider from '../../components/DepthSlider.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TopicNavFooter from '../../components/TopicNavFooter.astro';
import ProvenanceLedger from '../../components/ProvenanceLedger.astro';
import ActiveRecallCard from '../../components/ActiveRecallCard.astro';
import RelatedKnowledgeCard from '../../components/RelatedKnowledgeCard.astro';
import { resolveTopicNavigation } from '../../utils/navigation';
import { resolveAllRelationships } from '../../utils/relationships';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic }
  }));
}

const { topic } = Astro.props;
const allTopics = await getCollection('topics');
const { prev, next } = resolveTopicNavigation(topic.slug, allTopics);
const { bundleMap } = resolveAllRelationships(allTopics);
const relationshipBundle = bundleMap.get(topic.slug);
const { Content, headings } = await topic.render();

// Deterministic build-time reading time calculation (~225 words per minute)
const wordCount = topic.body ? topic.body.split(/\s+/).filter(Boolean).length : 0;
const calculatedReadingTime = Math.max(1, Math.ceil(wordCount / 225));

// Primary source / creator attribution if present
const primarySource = topic.data.sources && topic.data.sources.length > 0 ? topic.data.sources[0] : null;
---

<ReaderLayout title={topic.data.title} description={topic.data.summary_15s} currentSlug={topic.slug}>
  <article class="reader-article">
    
    <!-- ====================================================================
         TIER 1: ORIENTATION (Rajputana Gazette Editorial Masthead & Kicker)
         ==================================================================== -->
    <header class="reader-header">
      <!-- Editorial Kicker: Small Uppercase Sans-Serif -->
      <div class="kicker">
        <a href="/ytdecoded/" style="color: inherit; text-decoration: none;">THE LIVING CODEX</a> / VOLUME {topic.data.volume}: {topic.data.volume_title.toUpperCase()}
      </div>

      <!-- Authoritative 900-Weight Editorial Headline -->
      <h1 class="reader-topic-title" data-pagefind-meta="title">{topic.data.title}</h1>

      <!-- Editorial Metadata Strip: Clean Rules & Spatial Alignment -->
      <div class="reader-meta-bar">
        <span class="meta-item reading-time">READING TIME: {calculatedReadingTime} MIN</span>
        
        {primarySource && (
          <>
            <span class="meta-dot" aria-hidden="true">•</span>
            <span class="meta-item creator-pill">
              EVIDENCE: <strong>{primarySource.creator || primarySource.title}</strong>
            </span>
          </>
        )}

        <span class="meta-dot" aria-hidden="true">•</span>
        <span class="meta-item archetype-pill">{topic.data.archetype.replace(/_/g, ' ')}</span>

        {topic.data.tags && topic.data.tags.length > 0 && (
          <>
            <span class="meta-dot" aria-hidden="true">•</span>
            <div class="tag-group">
              {topic.data.tags.slice(0, 3).map((tag: string) => (
                <span class="tag-badge" data-pagefind-filter="tag">{tag.toUpperCase()}</span>
              ))}
            </div>
          </>
        )}
      </div>

      <!-- 15-Second Axiomatic Summary Kernel (Intelligence Box Pattern) -->
      <div class="summary-kernel special-box" data-pagefind-meta="summary">
        <div class="summary-kernel-label">WHAT THIS MEANS / CORE AXIOM</div>
        <div class="summary-kernel-text">{topic.data.summary_15s}</div>
      </div>

      <!-- Progressive Depth Reading Mode Toggle -->
      <DepthSlider />

      <!-- Subordinate, Collapsible Table of Contents -->
      <TableOfContents headings={headings} />
    </header>

    <!-- ====================================================================
         TIER 2: UNDERSTANDING (Uninterrupted First-Principles Prose)
         ==================================================================== -->
    <section class="reader-prose prose" aria-label="Chapter Body">
      <Content />
    </section>

    <!-- ====================================================================
         TIER 3: CONSOLIDATION (Recall, Concept Bridges, Sources & Next Steps)
         ==================================================================== -->
    <footer class="reader-consolidation" aria-label="Consolidation & Extended Learning">
      
      <!-- 1. Active Recall Self-Testing (Omitted gracefully if questions empty) -->
      <ActiveRecallCard questions={topic.data.active_recall || []} />

      <!-- 2. Human-Readable Concept Bridges -->
      <RelatedKnowledgeCard bundle={relationshipBundle} />

      <!-- 3. Source Citations & Video Timestamp Ledger -->
      <ProvenanceLedger sources={topic.data.sources} />

      <!-- 4. Sequential Chapter Navigation -->
      <TopicNavFooter prev={prev} next={next} />
    </footer>

  </article>
</ReaderLayout>
