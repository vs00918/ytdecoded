import ReaderLayout from '../layouts/ReaderLayout.astro';
import { getCollection } from 'astro:content';
import { getVolumeGroups } from '../utils/navigation';

// Fetch all topics dynamically from Astro Content Collection
const allTopics = await getCollection('topics');
const rawVolumeGroups = getVolumeGroups(allTopics);

// Compute global corpus metrics dynamically
const totalTopics = allTopics.length;
const totalVolumes = rawVolumeGroups.length;
const totalWordCount = allTopics.reduce((acc, t) => acc + (t.body ? t.body.split(/\s+/).filter(Boolean).length : 0), 0);
const totalReadingHours = (totalWordCount / 225 / 60).toFixed(1);

// Helper for Roman Numerals
function toRoman(num: number): string {
  const lookup: Record<string, number> = {
    M: 1000, CM: 900, D: 500, CD: 400, C: 100, XC: 90,
    L: 50, XL: 40, X: 10, IX: 9, V: 5, IV: 4, I: 1
  };
  let roman = '';
  for (const i in lookup) {
    while (num >= lookup[i]) {
      roman += i;
      num -= lookup[i];
    }
  }
  return roman || 'I';
}

// Dynamic Volume Size Tier Classification (Determines editorial card weight)
function getVolumeSizeTier(count: number): 'hero' | 'large' | 'medium' | 'compact' {
  if (count >= 16) return 'hero';
  if (count >= 9) return 'large';
  if (count >= 4) return 'medium';
  return 'compact';
}

// Dynamic Domain Identity & Visual Palette Accent
function getVolumeVisualTheme(title: string, volumeNumber: number) {
  const t = title.toLowerCase();
  if (t.includes('biology') || t.includes('energy') || t.includes('brain') || t.includes('mind')) {
    return {
      key: 'biology',
      glyph: '🧬',
      domainLabel: 'Cognitive Neurobiology & Somatic Systems',
      accentColor: '#2d6a4f',
      accentSoft: 'rgba(45, 106, 79, 0.12)'
    };
  }
  if (t.includes('wealth') || t.includes('capital') || t.includes('allocation') || t.includes('money')) {
    return {
      key: 'wealth',
      glyph: '🏛️',
      domainLabel: 'Capital Dynamics & Asymmetric Leverage',
      accentColor: '#b08968',
      accentSoft: 'rgba(176, 137, 104, 0.12)'
    };
  }
  if (t.includes('philosophy') || t.includes('action') || t.includes('metacognition')) {
    return {
      key: 'metacognition',
      glyph: '⚖️',
      domainLabel: 'Philosophy of Action & Metacognitive Mastery',
      accentColor: '#936639',
      accentSoft: 'rgba(147, 102, 57, 0.12)'
    };
  }
  if (t.includes('execution') || t.includes('velocity') || t.includes('leverage')) {
    return {
      key: 'execution',
      glyph: '⚡',
      domainLabel: 'Execution Physics & Kinetic Systems',
      accentColor: '#a24857',
      accentSoft: 'rgba(162, 72, 87, 0.12)'
    };
  }
  if (t.includes('social') || t.includes('sovereignty') || t.includes('communication')) {
    return {
      key: 'social',
      glyph: '🌐',
      domainLabel: 'Social Sovereignty & Human Dynamics',
      accentColor: '#585b70',
      accentSoft: 'rgba(88, 91, 112, 0.12)'
    };
  }
  if (t.includes('existential') || t.includes('purpose') || t.includes('summit')) {
    return {
      key: 'existential',
      glyph: '🏔️',
      domainLabel: 'Existential Philosophy & The Summit',
      accentColor: '#4a6fa5',
      accentSoft: 'rgba(74, 111, 165, 0.12)'
    };
  }
  
  // Graceful fallback for any newly added volume in the future
  const dynamicPalettes = [
    { key: 'alpha', glyph: '📜', domainLabel: 'Core Foundations', accentColor: '#7a5901', accentSoft: 'rgba(122, 89, 1, 0.12)' },
    { key: 'beta', glyph: '🧭', domainLabel: 'Applied Frameworks', accentColor: '#3d6375', accentSoft: 'rgba(61, 99, 117, 0.12)' },
    { key: 'gamma', glyph: '🔭', domainLabel: 'Advanced Synthesis', accentColor: '#5c4d7d', accentSoft: 'rgba(92, 77, 125, 0.12)' }
  ];
  return dynamicPalettes[volumeNumber % dynamicPalettes.length];
}

// Dynamic Domain Thesis / Description Synthesizer
function getVolumeThesis(group: { volume: number; volumeTitle: string; topics: any[] }): string {
  const knownTheses: Record<string, string> = {
    'The Biology of Mind & Energy': 'Physical and neurological foundations of peak cognition: dopamine regulation, circadian rhythm, sleep architecture, and the gut-mind axis.',
    'The Architecture of Wealth & Capital Allocation': 'Structural mechanisms of capital compounding, asymmetric leverage, the three currencies of wealth, and long-term asset allocation.',
    'Philosophy of Action & Metacognition': 'The psychology of internal sovereignty: cognitive bias dismantling, emotional granularity, deliberate practice, and the craft-first paradigm.',
    'High-Velocity Execution & Asymmetric Leverage': 'The operational mechanics of deliberate action: conquering activation energy, eliminating procrastination, and high-agency execution.',
    'The Architecture of Social Sovereignty': 'Structural analysis of modern human dynamics, difficult conversations, deception detection, the dramaturgical front stage, and relational empathy.',
    'Existential Sovereignty, Purpose & The Summit': 'Radical resilience, existential philosophy, and classical critiques of societal systems from ancient Athens to the Anthropocene.'
  };

  if (knownTheses[group.volumeTitle]) {
    return knownTheses[group.volumeTitle];
  }

  // Synthesize dynamically from constituent topic metadata
  const tags = Array.from(new Set(group.topics.flatMap((t: any) => t.data.tags || []))).slice(0, 4);
  if (tags.length > 0) {
    return `Comprehensive treatises and first-principles mental models exploring ${tags.join(', ')}.`;
  }
  return 'Syntopical chapters exploring first-principles frameworks, mental models, and sovereign mastery.';
}

// Process all volumes dynamically
const volumeCards = rawVolumeGroups.map((group) => {
  const volumeNumber = group.volume;
  const romanVol = toRoman(volumeNumber);
  const sizeTier = getVolumeSizeTier(group.topics.length);
  const visualTheme = getVolumeVisualTheme(group.volumeTitle, volumeNumber);
  const thesis = getVolumeThesis(group);

  const volWordCount = group.topics.reduce((acc, t) => acc + (t.body ? t.body.split(/\s+/).filter(Boolean).length : 0), 0);
  const volReadingTime = Math.max(1, Math.ceil(volWordCount / 225));
  const volHours = (volWordCount / 225 / 60).toFixed(1);

  // Extract unique thinkers/creators
  const uniqueCreators = Array.from(
    new Set(group.topics.flatMap((t: any) => t.data.sources?.map((s: any) => s.creator) || []).filter(Boolean) as string[])
  );

  // Calculate topic list and preview slice based on card weight
  const processedTopics = group.topics.map((t: any) => {
    const wordCount = t.body ? t.body.split(/\s+/).filter(Boolean).length : 0;
    const readingTime = Math.max(1, Math.ceil(wordCount / 225));
    const creator = t.data.sources && t.data.sources.length > 0 ? t.data.sources[0].creator : null;
    return {
      topic: t,
      readingTime,
      creator
    };
  });

  // Number of preview topics shown directly on the card
  const previewCount = sizeTier === 'hero' ? 6 : sizeTier === 'large' ? 4 : sizeTier === 'medium' ? 3 : group.topics.length;
  const previewTopics = processedTopics.slice(0, previewCount);
  const remainingCount = group.topics.length - previewCount;

  return {
    ...group,
    volumeNumber,
    romanVol,
    sizeTier,
    visualTheme,
    thesis,
    volReadingTime,
    volHours,
    uniqueCreators,
    processedTopics,
    previewTopics,
    remainingCount
  };
});
---

<ReaderLayout title="Library Catalog" description="The Living Codex — Master Personal Knowledge Library">
  <div class="library-container">
    
    <!-- ====================================================================
         HERO SECTION: ACADEMIC LIBRARY BANNER & SEARCH
         ==================================================================== -->
    <header class="library-hero">
      <div class="library-badge-row">
        <span class="library-badge">LIVING CODEX</span>
        <span class="library-badge-sub">PERSONAL KNOWLEDGE LIBRARY</span>
      </div>

      <h1 class="library-title">The Living Codex</h1>
      
      <p class="library-mission">
        Sovereign first-principles frameworks, cognitive mechanisms & mental models distilled from rigorous masterclasses into permanent, interconnected knowledge.
      </p>

      <!-- Prominent Library Search Trigger Field -->
      <div class="library-search-field-wrap">
        <button 
          id="library-search-btn" 
          class="library-search-field" 
          aria-label="Open Search across the Living Codex"
          title="Search the Living Codex (Press /)"
        >
          <span class="search-field-icon" aria-hidden="true">🔍</span>
          <span class="search-field-placeholder">Search knowledge, mental models, mechanisms, or authors...</span>
          <kbd class="search-field-kbd">/</kbd>
        </button>
      </div>

      <!-- Live Dynamic Corpus Stat Strip -->
      <div class="library-stat-ribbon">
        <div class="stat-pill">
          <span class="stat-value">{totalVolumes}</span>
          <span class="stat-label">Volumes</span>
        </div>
        <span class="stat-separator" aria-hidden="true">•</span>
        <div class="stat-pill">
          <span class="stat-value">{totalTopics}</span>
          <span class="stat-label">Syntopical Treatises</span>
        </div>
        <span class="stat-separator" aria-hidden="true">•</span>
        <div class="stat-pill">
          <span class="stat-value">~{totalReadingHours}</span>
          <span class="stat-label">Hours of Study</span>
        </div>
        <span class="stat-separator" aria-hidden="true">•</span>
        <div class="stat-pill">
          <span class="stat-badge-online">⚡ Offline Semantic Index</span>
        </div>
      </div>
    </header>

    <!-- ====================================================================
         SECTION 2: CONTINUE STUDYING (Dynamic from localStorage)
         ==================================================================== -->
    <section id="continue-reading-section" class="continue-study-section" style="display: none;" aria-label="Continue Studying">
      <div class="continue-study-card">
        <div class="continue-study-top">
          <span class="continue-study-badge">✦ CONTINUE STUDYING</span>
          <button id="dismiss-continue-btn" class="continue-dismiss-btn" aria-label="Dismiss Continue Reading Card">✕</button>
        </div>
        <div class="continue-study-body">
          <h2 id="continue-reading-title" class="continue-study-title">Topic Title</h2>
          <p id="continue-reading-summary" class="continue-study-summary">Topic summary...</p>
        </div>
        <div class="continue-study-bottom">
          <a id="continue-reading-link" href="#" class="continue-study-btn">
            Resume Study →
          </a>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 3: KNOWLEDGE VOLUMES CATALOG (VARIABLE-SIZE EDITORIAL GRID)
         ==================================================================== -->
    <main class="library-catalog-section" aria-label="Knowledge Volumes Catalog">
      <div class="catalog-section-header">
        <div>
          <h2 class="catalog-title">Knowledge Volumes</h2>
          <p class="catalog-subtitle">Explore the foundational bodies of thought across the codex</p>
        </div>
        <div class="catalog-global-actions">
          <button id="expand-all-btn" class="catalog-control-btn" title="Expand all volume drawers">
            ▾ Expand All Shelves
          </button>
          <button id="collapse-all-btn" class="catalog-control-btn" title="Collapse all volume drawers">
            ▴ Collapse Shelves
          </button>
        </div>
      </div>

      <!-- Variable-Size Responsive Grid -->
      <div class="library-volumes-grid">
        {volumeCards.map((vol) => (
          <article 
            class={`volume-book-card tier-${vol.sizeTier}`} 
            id={`volume-card-${vol.volumeNumber}`}
            style={`--vol-accent: ${vol.visualTheme.accentColor}; --vol-accent-soft: ${vol.visualTheme.accentSoft};`}
            aria-labelledby={`vol-title-${vol.volumeNumber}`}
          >
            <!-- Card Interior Frame -->
            <div class="volume-card-inner">
              
              <!-- Card Header / Spine Indicator -->
              <header class="volume-card-header">
                <div class="volume-header-left">
                  <span class="volume-roman-badge">VOL. {vol.romanVol}</span>
                  <span class="volume-domain-tag">{vol.visualTheme.domainLabel}</span>
                </div>
                <div class="volume-header-right">
                  <span class="volume-count-chip">{vol.topics.length} {vol.topics.length === 1 ? 'Topic' : 'Topics'}</span>
                  <span class="volume-time-chip">⏱️ {vol.volReadingTime}m</span>
                </div>
              </header>

              <!-- Volume Title & Thesis -->
              <div class="volume-card-main">
                <h3 id={`vol-title-${vol.volumeNumber}`} class="volume-card-title">
                  <a href={`/ytdecoded/volumes/${vol.volumeNumber}/`} class="volume-card-title-link">
                    {vol.volumeTitle}
                  </a>
                </h3>

                <p class="volume-card-thesis">{vol.thesis}</p>

                <!-- Synthesized Thinkers Strip -->
                {vol.uniqueCreators.length > 0 && (
                  <div class="volume-thinkers-strip">
                    <span class="thinkers-icon" aria-hidden="true">🧠</span>
                    <span class="thinkers-text">
                      Synthesizing: <strong>{vol.uniqueCreators.slice(0, 3).join(', ')}</strong>{vol.uniqueCreators.length > 3 ? ` +${vol.uniqueCreators.length - 3} more` : ''}
                    </span>
                  </div>
                )}
              </div>

              <!-- Representative Topics Preview Shelf -->
              <div class="volume-preview-shelf">
                <div class="preview-shelf-label">Featured Topics:</div>
                <ul class="preview-topics-list">
                  {vol.previewTopics.map(({ topic: t, readingTime }) => (
                    <li class="preview-topic-item">
                      <a href={`/ytdecoded/topics/${t.slug}/`} class="preview-topic-link">
                        <span class="preview-topic-order">#{t.data.order_in_volume}</span>
                        <span class="preview-topic-title">{t.data.title}</span>
                        <span class="preview-topic-time">{readingTime}m</span>
                      </a>
                    </li>
                  ))}
                </ul>

                {vol.remainingCount > 0 && (
                  <div class="preview-remaining-note">
                    + {vol.remainingCount} additional {vol.remainingCount === 1 ? 'treatise' : 'treatises'} in this volume
                  </div>
                )}
              </div>

              <!-- Card Action Bar -->
              <footer class="volume-card-footer">
                <a 
                  href={`/ytdecoded/volumes/${vol.volumeNumber}/`} 
                  class="volume-enter-btn"
                  title={`Read complete Volume ${vol.romanVol} on a continuous reading canvas`}
                >
                  Enter Volume ({vol.topics.length}) →
                </a>

                <button 
                  type="button"
                  class="volume-drawer-btn" 
                  id={`toggle-btn-${vol.volumeNumber}`}
                  data-count={vol.topics.length}
                  aria-expanded="false"
                  aria-controls={`drawer-${vol.volumeNumber}`}
                  onclick={`toggleShelfDrawer(${vol.volumeNumber})`}
                  title="Browse all topics in this volume on the homepage"
                >
                  <span class="toggle-icon">▾</span>
                  <span class="toggle-label">All {vol.topics.length} Topics</span>
                </button>
              </footer>

              <!-- Full Collapsible Topic Drawer -->
              <div 
                id={`drawer-${vol.volumeNumber}`} 
                class="volume-full-drawer"
                aria-hidden="true"
              >
                <div class="volume-drawer-inner">
                  <div class="drawer-topics-grid">
                    {vol.processedTopics.map(({ topic: t, readingTime, creator }) => (
                      <a href={`/ytdecoded/topics/${t.slug}/`} class="drawer-topic-card">
                        <div class="drawer-topic-header">
                          <span class="drawer-topic-order">#{t.data.order_in_volume}</span>
                          <span class="drawer-topic-time">⏱️ {readingTime}m</span>
                        </div>
                        <div class="drawer-topic-title">{t.data.title}</div>
                        {t.data.summary_15s && (
                          <div class="drawer-topic-summary">{t.data.summary_15s}</div>
                        )}
                        {creator && (
                          <div class="drawer-topic-creator">Mind: <strong>{creator}</strong></div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
    </main>

  </div>
</ReaderLayout>

<style>
