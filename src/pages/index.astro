    animation: pulse-dot 2s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .feed-pill-bold {
    font-weight: 700;
    color: var(--text-primary);
  }

  .feed-pill-sep {
    opacity: 0.4;
  }

  .feed-heading {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px;
    line-height: 1.25;
  }

  .feed-subheading {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* View Mode Switcher */
  .codex-view-switcher {
    display: inline-flex;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 3px;
    gap: 4px;
    align-self: center;
  }

  .view-switch-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .view-switch-btn:hover {
    color: var(--text-primary);
  }

  .view-switch-btn.active {
    background: var(--bg-card);
    color: var(--text-primary);
    box-shadow: 0 2px 8px var(--shadow);
    border: 1px solid var(--border-subtle);
  }

  .view-switch-icon {
    font-size: 0.95rem;
  }

  .view-switch-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--wash, rgba(0,0,0,0.05));
    border: 1px solid var(--rule, rgba(0,0,0,0.1));
  }

  /* Timeline Grid */
  .timeline-stream-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .timeline-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
