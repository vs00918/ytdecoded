    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .library-title {
    font-family: var(--font-serif);
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  @media (max-width: 768px) {
    .library-title {
      font-size: 2.25rem;
    }
  }

  .library-mission {
    max-width: 680px;
    margin: 0 auto 32px auto;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Search Field Bar */
  .library-search-field-wrap {
    max-width: 640px;
    margin: 0 auto 28px auto;
  }

  .library-search-field {
    width: 100%;
