                  <div class="timeline-card-top">
                    <div class="timeline-badge-group">
                      <span class="timeline-date-tag">{formatTopicDate(topic.data.last_updated)}</span>
                      <span class="timeline-vol-tag">Vol. {toRoman(topic.data.volume)}</span>
                    </div>
                    <span class="timeline-time-badge">⏱️ {readingTime}m</span>
                  </div>
                  <h3 class="timeline-card-title">{topic.data.title}</h3>
                  {topic.data.summary_15s && (
                    <p class="timeline-card-summary">{topic.data.summary_15s}</p>
                  )}
                  <div class="timeline-card-footer">
                    {creator ? (
                      <span class="timeline-creator-tag">Source: <strong>{creator}</strong></span>
                    ) : (
                      <span class="timeline-creator-tag">Archetype: <strong>{topic.data.archetype.replace('_', ' ')}</strong></span>
                    )}
