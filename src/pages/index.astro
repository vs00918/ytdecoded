    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
    gap: 16px;
    flex-wrap: wrap;
  }

  .catalog-title {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .catalog-subtitle {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .catalog-global-actions {
    display: flex;
    gap: 10px;
  }

  .catalog-control-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 6px 14px;
    border-radius: 6px;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .catalog-control-btn:hover {
    background: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--accent);
  }

  /* --------------------------------------------------------------------------
     VARIABLE-SIZE EDITORIAL GRID
     -------------------------------------------------------------------------- */
  .library-volumes-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 28px;
  }

  /* Tier-based column spans for responsive editorial layout */
  .volume-book-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 4px 14px var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .volume-book-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--shadow);
    border-color: var(--vol-accent, var(--accent));
  }

