            <span class="view-switch-count">{volumeCards.length}</span>
          </button>
        </div>
      </div>

      <!-- Chronological Cards Grid (Recent 6 items shown initially) -->
      <div id="timeline-stream-container" class="timeline-stream-container">
        <div class="timeline-cards-grid">
          {recentTopics.slice(0, 6).map((topic) => {
            const isNew = topic.data.last_updated === latestDate;
            const readingTime = topic.data.reading_time_minutes || Math.max(1, Math.ceil((topic.body?.split(/\s+/).filter(Boolean).length || 0) / 225));
            const creator = topic.data.sources && topic.data.sources.length > 0 ? topic.data.sources[0].creator : null;
            return (
              <a href={`/ytdecoded/topics/${topic.slug}/`} class="timeline-card">
                <div class="timeline-card-top">
                  <div class="timeline-badge-group">
                    <span class={`timeline-date-tag ${isNew ? 'is-fresh' : ''}`}>
                      {formatTopicDate(topic.data.last_updated)}
                    </span>
                    {isNew && <span class="timeline-new-pill">NEW</span>}
