---
import ReaderLayout from "../layouts/ReaderLayout.astro";
import PhilosophyFirstAid from "../components/PhilosophyFirstAid.astro";
import { getCollection } from "astro:content";
import { getVolumeGroups } from "../utils/navigation";

// Fetch all topics dynamically from Astro Content Collection
const allTopics = await getCollection("topics");
const rawVolumeGroups = getVolumeGroups(allTopics);

// Compute global corpus metrics dynamically
const totalTopics = allTopics.length;
const totalVolumes = rawVolumeGroups.length;
const totalWordCount = allTopics.reduce((acc, t) => acc + (t.body ? t.body.split(/\s+/).filter(Boolean).length : 0), 0);
const totalReadingHours = (totalWordCount / 225 / 60).toFixed(1);

// Helper for Roman Numerals
function toRoman(num: number): string {
  const lookup: Record<string, number> = {
    M: 1000, CM: 900, D: 500, CD: 400, C: 100, XC: 90,
    L: 50, XL: 40, X: 10, IX: 9, V: 5, IV: 4, I: 1
  };
  let roman = "";
  for (const i in lookup) {
    while (num >= lookup[i]) {
      roman += i;
      num -= lookup[i];
    }
  }
  return roman || "I";
}

// Domain visual themes, labels, colors & illustrations
function getVolumeVisualTheme(title: string, volumeNumber: number) {
  const t = title.toLowerCase();
  if (t.includes("biology") || t.includes("energy") || t.includes("brain") || t.includes("mind")) {
    return {
      key: "biology",
      domainLabel: "COGNITIVE NEUROBIOLOGY & SOMATIC SYSTEMS",
      shortLabel: "Neurobiology & Energy",
      accentColor: "#2d6a4f",
      accentSoft: "#e8f4ec",
      illustration: "/ytdecoded/assets/volumes/vol1-neurobiology.svg"
    };
  }
  if (t.includes("wealth") || t.includes("capital") || t.includes("allocation") || t.includes("money")) {
    return {
      key: "wealth",
      domainLabel: "CAPITAL DYNAMICS & ASYMMETRIC LEVERAGE",
      shortLabel: "Capital & Compounding",
      accentColor: "#936639",
      accentSoft: "#f7ede2",
      illustration: "/ytdecoded/assets/volumes/vol2-wealth.svg"
    };
  }
  if (t.includes("philosophy") || t.includes("action") || t.includes("metacognition")) {
    return {
      key: "metacognition",
      domainLabel: "PHILOSOPHY OF ACTION & METACOGNITIVE MASTERY",
      shortLabel: "Action & Metacognition",
      accentColor: "#8a2839",
      accentSoft: "#fcedef",
      illustration: "/ytdecoded/assets/volumes/vol3-metacognition.svg"
    };
  }
  if (t.includes("execution") || t.includes("velocity") || t.includes("leverage")) {
    return {
      key: "execution",
      domainLabel: "EXECUTION PHYSICS & KINETIC SYSTEMS",
      shortLabel: "Execution Physics",
      accentColor: "#a24857",
      accentSoft: "#fbe9eb",
      illustration: "/ytdecoded/assets/volumes/vol4-execution.svg"
    };
  }
  if (t.includes("social") || t.includes("sovereignty") || t.includes("communication")) {
    return {
      key: "social",
      domainLabel: "SOCIAL SOVEREIGNTY & HUMAN DYNAMICS",
      shortLabel: "Social Sovereignty",
      accentColor: "#3b4d6b",
      accentSoft: "#e9eef5",
      illustration: "/ytdecoded/assets/volumes/vol5-social.svg"
    };
  }
  if (t.includes("existential") || t.includes("purpose") || t.includes("summit")) {
    return {
      key: "existential",
      domainLabel: "EXISTENTIAL PHILOSOPHY & THE SUMMIT",
      shortLabel: "Existential Philosophy",
      accentColor: "#2c3e6b",
      accentSoft: "#e8ecf8",
      illustration: "/ytdecoded/assets/volumes/vol6-summit.svg"
    };
  }
  return {
    key: "general",
    domainLabel: "FOUNDATIONAL SYSTEMS & COGNITION",
    shortLabel: "Foundations",
    accentColor: "#4a5568",
    accentSoft: "#edf2f7",
    illustration: "/ytdecoded/assets/volumes/vol1-neurobiology.svg"
  };
}

// Volume Thesis / Core Premise
function getVolumeThesis(group: { volume: number; volumeTitle: string; topics: any[] }): string {
  const knownTheses: Record<string, string> = {
    "The Biology of Mind & Energy": "Physical and neurological foundations of peak cognition: dopamine regulation, circadian rhythm, sleep architecture, and the gut-mind axis.",
    "The Architecture of Wealth & Capital Allocation": "Structural mechanisms of capital compounding, asymmetric leverage, the three currencies of wealth, and long-term asset allocation.",
    "Philosophy of Action & Metacognition": "The psychology of internal sovereignty: cognitive bias dismantling, emotional granularity, deliberate practice, and the craft-first paradigm.",
    "High-Velocity Execution & Asymmetric Leverage": "The operational mechanics of deliberate action: conquering activation energy, eliminating procrastination, and high-agency execution.",
    "The Architecture of Social Sovereignty": "Structural analysis of modern human dynamics, difficult conversations, deception detection, the dramaturgical front stage, and relational empathy.",
    "Existential Sovereignty, Purpose & The Summit": "Radical resilience, existential philosophy, and classical critiques of societal systems from ancient Athens to the Anthropocene."
  };

  if (knownTheses[group.volumeTitle]) {
    return knownTheses[group.volumeTitle];
  }

  const tags = Array.from(new Set(group.topics.flatMap((t: any) => t.data.tags || []))).slice(0, 4);
  if (tags.length > 0) {
    return `Comprehensive treatises and first-principles mental models exploring ${tags.join(", ")}.`;
  }
  return "Syntopical chapters exploring first-principles frameworks, mental models, and sovereign mastery.";
}

// 3 Curated Inquiries for each volume (What questions does this volume answer?)
function getVolumeInquiries(volumeNumber: number): string[] {
  const inquiries: Record<number, string[]> = {
    1: [
      "How do gut microbiota and vagus nerve signaling dictate mood, mental clarity, and anxiety?",
      "What is the exact neurochemical mechanism of dopamine loading, baseline exhaustion, and focus recovery?",
      "How do circadian light cues and 90-minute sleep stages govern memory consolidation and learning retention?"
    ],
    2: [
      "What separates productive leverage from destructive compounding debt in long-term wealth building?",
      "How do cashflow velocity and asymmetric risk profile govern financial autonomy?",
      "How do economic, cultural, and social currencies compound across multi-decade horizons?"
    ],
    3: [
      "How do you mathematically dismantle procrastination and lower activation energy using the 3-second rule?",
      "Why does standard willpower fail, and how do quad-block circadian routines enable sustainable 10-12 hour deep work?",
      "How do epistemic razors, cognitive bias firewalls, and metacognitive awareness neutralize overthinking?"
    ],
    4: [
      "Why is physical and psychological comfort a neurological pathology that erodes resilience?",
      "How does progressive friction retrain baseline homeostasis to thrive under acute pressure?",
      "How do you engineer high-agency momentum when external conditions and motivation collapse?"
    ],
    5: [
      "How do Erving Goffman's front-stage vs. backstage dynamics explain imposter syndrome in social hierarchies?",
      "What are the conversational matching principles of supercommunicators during intense interpersonal conflict?",
      "How do game theory and tit-for-tat strategies create sovereign cooperation without vulnerability?"
    ],
    6: [
      "How does affect labeling and emotional granularity biochemically calm the amygdala during acute crisis?",
      "What separates Marcus Aurelius's Inner Citadel from passive suppression or emotional detachment?",
      "How do active nihilism, Spinozan rationalism, and Nietzschean self-overcoming forge unshakeable purpose?"
    ]
  };
  return inquiries[volumeNumber] || [
    "What are the foundational first principles governing this discipline?",
    "How can these mental models be tested and applied in high-stakes environments?",
    "What cognitive biases and structural illusions must be dismantled first?"
  ];
}

// Process volumes for the view
const volumeCards = rawVolumeGroups.map((group) => {
  const volumeNumber = group.volume;
  const romanVol = toRoman(volumeNumber);
  const visualTheme = getVolumeVisualTheme(group.volumeTitle, volumeNumber);
  const thesis = getVolumeThesis(group);
  const keyInquiries = getVolumeInquiries(volumeNumber);

  const volWordCount = group.topics.reduce((acc, t) => acc + (t.body ? t.body.split(/\s+/).filter(Boolean).length : 0), 0);
  const volReadingTime = Math.max(1, Math.ceil(volWordCount / 225));

  // Flagship featured volume (Volume 3 with 24 topics)
  const isFlagship = volumeNumber === 3;

  // Extract unique thinkers/creators
  const uniqueCreators = Array.from(
    new Set(group.topics.flatMap((t: any) => t.data.sources?.map((s: any) => s.creator) || []).filter(Boolean) as string[])
  ).slice(0, 5);

  // Calculate processed topics
  const processedTopics = group.topics.map((t: any) => {
    const wordCount = t.body ? t.body.split(/\s+/).filter(Boolean).length : 0;
    const readingTime = Math.max(1, Math.ceil(wordCount / 225));
    const creator = t.data.sources && t.data.sources.length > 0 ? t.data.sources[0].creator : null;
    return {
      topic: t,
      readingTime,
      creator
    };
  });

  // Preview shelf
  const previewCount = isFlagship ? 4 : Math.min(group.topics.length, 3);
  const previewTopics = processedTopics.slice(0, previewCount);
  const remainingCount = group.topics.length - previewCount;

  return {
    ...group,
    volumeNumber,
    romanVol,
    visualTheme,
    thesis,
    keyInquiries,
    volReadingTime,
    isFlagship,
    uniqueCreators,
    processedTopics,
    previewTopics,
    remainingCount
  };
});
---

<ReaderLayout title="Library Catalog" description="The Living Codex — Master Personal Knowledge Library" isWideLayout={true} hideNavSearch={true}>
  <div class="library-app-canvas">
    
    <!-- ====================================================================
         SECTION 1: EDITORIAL HERO & PRIMARY SEARCH DOOR
         ==================================================================== -->
    <header class="codex-hero-section">
      <div class="hero-badge-pill">
        <span class="hero-badge-bold">THE LIVING CODEX</span>
        <span class="hero-badge-dot">•</span>
        <span class="hero-badge-light">PERSONAL KNOWLEDGE LIBRARY</span>
      </div>

      <h1 class="codex-hero-title">The Living Codex</h1>
      
      <p class="codex-hero-subtitle">
        A personal library of ideas worth understanding deeply. Explore first principles, mental models, cognitive science, philosophy, and the structural systems that connect them.
      </p>

      <!-- Primary Search Door (Elevated UX) -->
      <div class="codex-search-door-wrap">
        <button 
          id="library-search-btn" 
          class="codex-search-door-btn" 
          aria-label="Open Search across the Living Codex"
          title="Search the Living Codex (Press /)"
        >
          <div class="search-door-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <div class="search-door-text-group">
            <span class="search-door-primary">Search the entire Codex library...</span>
            <span class="search-door-secondary">Ideas, first principles, mental models, authors & mechanisms</span>
          </div>
          <div class="search-door-kbd-group">
            <kbd class="search-door-kbd">/</kbd>
          </div>
        </button>
      </div>

      <!-- Interactive Philosophy as First Aid -->
      <div class="hero-first-aid-wrap">
        <PhilosophyFirstAid />
      </div>
    </header>

    <!-- ====================================================================
         SECTION 2: RESUME STUDYING (Dynamic from localStorage)
         ==================================================================== -->
    <section id="continue-reading-section" class="continue-study-section" style="display: none;" aria-label="Resume Studying">
      <div class="continue-study-banner">
        <div class="continue-study-left">
          <div class="continue-book-icon-box">
            <span aria-hidden="true">📖</span>
          </div>
          <div class="continue-meta-content">
            <div class="continue-label-tag">RESUME WHERE YOU LEFT OFF</div>
            <h2 id="continue-reading-title" class="continue-topic-title">The Architecture of Memory and Active Recall</h2>
          </div>
        </div>

        <div class="continue-study-right">
          <a id="continue-reading-link" href="#" class="continue-resume-btn">
            Resume Reading →
          </a>
          <button id="dismiss-continue-btn" class="continue-dismiss-link" aria-label="Dismiss resume prompt">
            ✕ Dismiss
          </button>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 3: ORIENTATION LAYER — CURRICULUM ARCHITECTURE ROADMAP
         Allows immediate comparison of all 6 volumes in one glance
         ==================================================================== -->
    <section class="curriculum-roadmap-section" aria-label="Curriculum Architecture">
      <div class="roadmap-header">
        <div class="roadmap-eyebrow">CURRICULUM ARCHITECTURE</div>
        <h2 class="roadmap-title">The Six Foundational Volumes</h2>
        <p class="roadmap-subtitle">Compare domains, chapter depth, and study commitments across the complete sequence.</p>
      </div>

      <div class="roadmap-pills-strip">
        {volumeCards.map((vol) => (
          <a 
            href={`#volume-card-${vol.volumeNumber}`} 
            class="roadmap-pill-link"
            style={`--pill-color: ${vol.visualTheme.accentColor}; --pill-soft: ${vol.visualTheme.accentSoft}; --pill-border: ${vol.visualTheme.accentColor}33;`}
          >
            <div class="pill-top-row">
              <span class="pill-vol-badge">VOL. {vol.romanVol}</span>
              <span class="pill-metric">{vol.topics.length} Ch • {vol.volReadingTime}m</span>
            </div>
            <div class="pill-label">{vol.visualTheme.shortLabel}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- ====================================================================
         SECTION 4: DECISION-FIRST VOLUME CARDS
         ==================================================================== -->
    <main class="codex-catalog-section" aria-label="Knowledge Volumes Catalog">
      <div class="catalog-header-row">
        <div class="catalog-title-group">
          <h2 class="catalog-heading">Volume Deep Dive & Chapter Indexes</h2>
          <span class="catalog-caption-inline">Understand what each volume unlocks before entering</span>
        </div>
        <div class="catalog-control-buttons">
          <button id="expand-all-btn" class="catalog-action-btn" title="Expand all chapter drawers">
            <span class="action-icon">⛶</span> Expand All Chapters
          </button>
          <button id="collapse-all-btn" class="catalog-action-btn" title="Collapse all chapter drawers">
            <span class="action-icon">−</span> Collapse Drawers
          </button>
        </div>
      </div>

      <div class="editorial-volumes-stack">
        {volumeCards.map((vol, idx) => (
          <article 
            class={`editorial-volume-card ${vol.isFlagship ? "card-flagship-featured" : ""}`}
            id={`volume-card-${vol.volumeNumber}`}
            style={`--vol-color: ${vol.visualTheme.accentColor}; --vol-soft: ${vol.visualTheme.accentSoft}; --vol-border-light: ${vol.visualTheme.accentColor}25;`}
            aria-labelledby={`vol-title-${vol.volumeNumber}`}
          >
            <!-- Card Editorial Shell -->
            <div class="editorial-card-frame">
              
              <!-- 1. Header & Domain Label -->
              <div class="card-domain-header">
                <div class="domain-identity-left">
                  <span class="domain-vol-num">VOLUME {vol.romanVol}</span>
                  <span class="domain-bullet">•</span>
                  <span class="domain-title-text">{vol.visualTheme.domainLabel}</span>
                </div>
                <div class="domain-badge-scale">
                  <span class="scale-chapters"><strong>{vol.topics.length}</strong> {vol.topics.length === 1 ? "Chapter" : "Chapters"}</span>
                  <span class="scale-dot">•</span>
                  <span class="scale-time">~{vol.volReadingTime} min study</span>
                </div>
              </div>

              <!-- 2. Main Content Grid (Split Layout) -->
              <div class="card-split-body">
                
                <!-- Left Column: Artwork Plate & Foundational Thinkers -->
                <div class="card-artwork-column">
                  <div class="artwork-plate-frame">
                    <img 
                      src={vol.visualTheme.illustration} 
                      alt={`${vol.volumeTitle} Thematic Plate`}
                      class="artwork-img"
                      loading="lazy"
                    />
                    <div class="artwork-watermark-vol">{vol.romanVol}</div>
                  </div>

                  {vol.uniqueCreators.length > 0 && (
                    <div class="card-thinkers-shelf">
                      <div class="thinkers-label">KEY MINDS & SOURCES</div>
                      <div class="thinkers-pills-wrap">
                        {vol.uniqueCreators.map((creator) => (
                          <span class="thinker-tag">{creator}</span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>

                <!-- Right Column: Title, Thesis, Key Inquiries & Inside Chapter Shelf -->
                <div class="card-content-column">
                  
                  <div class="card-headline-group">
                    {vol.isFlagship && (
                      <div class="flagship-marker-badge">
                        <span>★ COMPREHENSIVE ANCHOR VOLUME</span>
                      </div>
                    )}
                    <h3 id={`vol-title-${vol.volumeNumber}`} class="card-volume-title">
                      <a href={`/ytdecoded/volumes/${vol.volumeNumber}/`} class="card-title-link">
                        {vol.volumeTitle}
                      </a>
                    </h3>

                    <p class="card-volume-thesis">{vol.thesis}</p>
                  </div>

                  <!-- 3. Crucial Decision Layer: What Questions Does This Volume Answer? -->
                  <div class="card-inquiries-box">
                    <div class="inquiries-box-header">
                      <span class="inquiries-icon" aria-hidden="true">💡</span>
                      <span class="inquiries-heading">WHAT QUESTIONS DOES THIS VOLUME ANSWER?</span>
                    </div>
                    <ul class="inquiries-list">
                      {vol.keyInquiries.map((inquiry) => (
                        <li class="inquiry-item">
                          <span class="inquiry-marker">›</span>
                          <span class="inquiry-text">{inquiry}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- 4. Inside This Volume (Explicit Chapter Shelf with Time Tags) -->
                  <div class="card-inside-shelf">
                    <div class="inside-shelf-header">
                      <span class="inside-shelf-label">INSIDE THIS VOLUME</span>
                      <span class="inside-shelf-preview-tag">
                        Showing {vol.previewTopics.length} of {vol.topics.length} {vol.topics.length === 1 ? "Chapter" : "Chapters"}
                      </span>
                    </div>

                    <div class="inside-chapters-grid">
                      {vol.previewTopics.map(({ topic: t, readingTime, creator }) => (
                        <a href={`/ytdecoded/topics/${t.slug}/`} class="inside-chapter-pill">
                          <div class="chapter-pill-top">
                            <span class="chapter-order-badge">#{t.data.order_in_volume}</span>
                            <span class="chapter-time-badge">⏱️ {readingTime}m</span>
                          </div>
                          <div class="chapter-pill-title">{t.data.title}</div>
                          {creator && (
                            <div class="chapter-pill-creator">{creator}</div>
                          )}
                        </a>
                      ))}
                    </div>

                    {vol.remainingCount > 0 && (
                      <div class="inside-shelf-more-row">
                        <button 
                          type="button" 
                          class="link-preview-more"
                          onclick={`toggleShelfDrawer(${vol.volumeNumber})`}
                          aria-label={`View remaining ${vol.remainingCount} chapters in Volume ${vol.romanVol}`}
                        >
                          + View {vol.remainingCount} more {vol.remainingCount === 1 ? "chapter" : "chapters"} in Volume {vol.romanVol} ▾
                        </button>
                      </div>
                    )}
                  </div>

                </div>
              </div>

              <!-- 5. Card Bottom Action Bar -->
              <footer class="card-action-footer">
                <div class="footer-left-actions">
                  <a 
                    href={`/ytdecoded/volumes/${vol.volumeNumber}/`} 
                    class="btn-enter-volume"
                    title={`Enter Volume ${vol.romanVol} — ${vol.volumeTitle}`}
                  >
                    Enter Volume {vol.romanVol} ({vol.topics.length} {vol.topics.length === 1 ? "Chapter" : "Chapters"}) →
                  </a>

                  <button 
                    type="button"
                    class="btn-toggle-drawer" 
                    id={`toggle-btn-${vol.volumeNumber}`}
                    data-count={vol.topics.length}
                    aria-expanded="false"
                    aria-controls={`drawer-${vol.volumeNumber}`}
                    onclick={`toggleShelfDrawer(${vol.volumeNumber})`}
                  >
                    <span class="drawer-btn-label">Preview all {vol.topics.length} chapters ▾</span>
                  </button>
                </div>

                {idx < volumeCards.length - 1 && (
                  <div class="footer-next-hint">
                    <span class="next-hint-text">Next: Vol. {volumeCards[idx + 1].romanVol} — {volumeCards[idx + 1].visualTheme.shortLabel}</span>
                  </div>
                )}
              </footer>

              <!-- 6. Collapsible Full Chapter Index Drawer -->
              <div 
                id={`drawer-${vol.volumeNumber}`} 
                class="volume-full-drawer"
                aria-hidden="true"
              >
                <div class="volume-drawer-inner">
                  <div class="drawer-inner-header">
                    <span class="drawer-inner-title">COMPLETE VOLUME INDEX ({vol.topics.length} CHAPTERS)</span>
                    <button 
                      type="button" 
                      class="drawer-close-btn"
                      onclick={`toggleShelfDrawer(${vol.volumeNumber})`}
                      aria-label="Close chapter index"
                    >
                      ✕ Close Index
                    </button>
                  </div>

                  <div class="drawer-topics-grid">
                    {vol.processedTopics.map(({ topic: t, readingTime, creator }) => (
                      <a href={`/ytdecoded/topics/${t.slug}/`} class="drawer-topic-card">
                        <div class="drawer-topic-header">
                          <span class="drawer-topic-order">Chapter #{t.data.order_in_volume}</span>
                          <span class="drawer-topic-time">⏱️ {readingTime}m</span>
                        </div>
                        <div class="drawer-topic-title">{t.data.title}</div>
                        {t.data.summary_15s && (
                          <div class="drawer-topic-summary">{t.data.summary_15s}</div>
                        )}
                        {creator && (
                          <div class="drawer-topic-creator">Mind: <strong>{creator}</strong></div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
    </main>

    <!-- ====================================================================
         SECTION 5: BOTTOM CORPUS METRIC STRIP
         ==================================================================== -->
    <section class="bottom-corpus-stat-section" aria-label="Codex Overview Statistics">
      <div class="codex-stat-strip">
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">📖</span>
          <div class="stat-info">
            <span class="stat-num">{totalVolumes}</span>
            <span class="stat-name">Volumes</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">🗂️</span>
          <div class="stat-info">
            <span class="stat-num">{totalTopics}</span>
            <span class="stat-name">Chapters</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">⏱️</span>
          <div class="stat-info">
            <span class="stat-num">~{totalReadingHours}</span>
            <span class="stat-name">Hours of Study</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon stat-accent-icon" aria-hidden="true">⚡</span>
          <div class="stat-info">
            <span class="stat-badge-text">100% Offline Semantic Index</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 6: EDITORIAL QUOTE FOOTER
         ==================================================================== -->
    <footer class="codex-quote-banner">
      <div class="quote-content-wrap">
        <span class="quote-symbol" aria-hidden="true">❝</span>
        <span class="quote-text">Knowledge is power only when it is understood, internalized, and applied.</span>
        <span class="quote-author">— The Living Codex</span>
      </div>
    </footer>

  </div>
</ReaderLayout>

<style>
  /* ==========================================================================
     LIVING CODEX: DECISION-FIRST EDITORIAL ARCHITECTURE
     ========================================================================== */

  .library-app-canvas {
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 20px 80px;
  }

  /* --------------------------------------------------------------------------
     HERO BANNER & PRIMARY SEARCH DOOR
     -------------------------------------------------------------------------- */
  .codex-hero-section {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 36px;
    padding: 10px 0 0;
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 4px 14px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .hero-badge-bold {
    font-weight: 700;
    color: var(--accent);
  }

  .hero-badge-dot {
    opacity: 0.4;
  }

  .hero-badge-light {
    font-weight: 500;
  }

  .codex-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .codex-hero-subtitle {
    font-family: var(--font-sans);
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 28px;
  }

  /* Elevated Search Door Field */
  .codex-search-door-wrap {
    max-width: 640px;
    margin: 0 auto 28px;
  }

  .codex-search-door-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg-card);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 12px 18px;
    cursor: pointer;
    box-shadow: 0 4px 14px var(--shadow);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
    text-align: left;
  }

  .codex-search-door-btn:hover {
    border-color: var(--accent);
    box-shadow: 0 6px 20px var(--shadow);
    transform: translateY(-1px);
  }

  .search-door-icon {
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .search-door-text-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .search-door-primary {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .search-door-secondary {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .search-door-kbd-group {
    flex-shrink: 0;
  }

  .search-door-kbd {
    display: inline-block;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .hero-first-aid-wrap {
    margin-top: 10px;
  }

  /* --------------------------------------------------------------------------
     CONTINUE STUDYING BANNER
     -------------------------------------------------------------------------- */
  .continue-study-section {
    margin-bottom: 32px;
  }

  .continue-study-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 8px;
    padding: 14px 20px;
    box-shadow: 0 2px 8px var(--shadow);
  }

  .continue-study-left {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .continue-book-icon-box {
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  .continue-label-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 2px;
  }

  .continue-topic-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .continue-study-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .continue-resume-btn {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: #fff !important;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .continue-resume-btn:hover {
    opacity: 0.9;
  }

  .continue-dismiss-link {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
  }

  .continue-dismiss-link:hover {
    color: var(--text-primary);
  }

  /* --------------------------------------------------------------------------
     SECTION 3: ORIENTATION LAYER (ROADMAP STRIP)
     -------------------------------------------------------------------------- */
  .curriculum-roadmap-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 40px;
    box-shadow: 0 2px 8px var(--shadow);
  }

  .roadmap-header {
    margin-bottom: 16px;
  }

  .roadmap-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .roadmap-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px;
  }

  .roadmap-subtitle {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .roadmap-pills-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 10px;
  }

  .roadmap-pill-link {
    display: block;
    background: var(--pill-soft);
    border: 1px solid var(--pill-border);
    border-radius: 8px;
    padding: 10px 12px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .roadmap-pill-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px var(--shadow);
  }

  .pill-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 4px;
  }

  .pill-vol-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--pill-color);
  }

  .pill-metric {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .pill-label {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  /* --------------------------------------------------------------------------
     SECTION 4: CATALOG HEADER & ACTION BAR
     -------------------------------------------------------------------------- */
  .codex-catalog-section {
    margin-bottom: 48px;
  }

  .catalog-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 24px;
    border-bottom: 1.5px solid var(--border);
  }

  .catalog-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .catalog-heading {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .catalog-caption-inline {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .catalog-control-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .catalog-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 12px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .catalog-action-btn:hover {
    background: var(--bg-card);
    border-color: var(--accent);
    color: var(--text-primary);
  }

  /* --------------------------------------------------------------------------
     DECISION-FIRST VOLUME CARDS STACK
     -------------------------------------------------------------------------- */
  .editorial-volumes-stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .editorial-volume-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 4px 14px var(--shadow);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .editorial-volume-card:hover {
    border-color: var(--vol-color);
    box-shadow: 0 6px 20px var(--shadow);
  }

  .card-flagship-featured {
    border-left: 5px solid var(--vol-color);
  }

  .editorial-card-frame {
    display: flex;
    flex-direction: column;
  }

  /* Domain Header */
  .card-domain-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 20px;
    background: var(--vol-soft);
    border-bottom: 1px solid var(--vol-border-light);
  }

  .domain-identity-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .domain-vol-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--vol-color);
    flex-shrink: 0;
  }

  .domain-bullet {
    color: var(--vol-color);
    opacity: 0.4;
  }

  .domain-title-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--vol-color);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .domain-badge-scale {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .scale-dot {
    opacity: 0.4;
  }

  /* Card Split Body */
  .card-split-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    padding: 24px;
  }

  @media (max-width: 860px) {
    .card-split-body {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* Left Artwork Column */
  .card-artwork-column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .artwork-plate-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background: var(--vol-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .artwork-img {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    z-index: 1;
    transition: transform 0.2s ease;
  }

  .editorial-volume-card:hover .artwork-img {
    transform: scale(1.04);
  }

  .artwork-watermark-vol {
    position: absolute;
    right: 8px;
    bottom: -4px;
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 900;
    color: var(--vol-color);
    opacity: 0.08;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .card-thinkers-shelf {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
  }

  .thinkers-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .thinkers-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .thinker-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Right Content Column */
  .card-content-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .card-headline-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .flagship-marker-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    background: var(--vol-soft);
    border: 1px solid var(--vol-border-light);
    color: var(--vol-color);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .card-volume-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.25;
  }

  .card-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title-link:hover {
    color: var(--vol-color);
  }

  .card-volume-thesis {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Key Inquiries Box (Crucial Decision Element) */
  .card-inquiries-box {
    background: var(--vol-soft);
    border: 1px solid var(--vol-border-light);
    border-radius: 8px;
    padding: 12px 16px;
  }

  .inquiries-box-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .inquiries-icon {
    font-size: 0.88rem;
  }

  .inquiries-heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--vol-color);
  }

  .inquiries-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .inquiry-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--text-primary);
  }

  .inquiry-marker {
    color: var(--vol-color);
    font-weight: 800;
    line-height: 1.2;
  }

  .inquiry-text {
    flex: 1;
  }

  /* Inside Chapter Shelf */
  .card-inside-shelf {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
  }

  .inside-shelf-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  .inside-shelf-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .inside-shelf-preview-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
  }

  .inside-chapters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 8px;
  }

  .inside-chapter-pill {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px 10px;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .inside-chapter-pill:hover {
    border-color: var(--vol-color);
    transform: translateY(-1px);
  }

  .chapter-pill-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .chapter-order-badge {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--vol-color);
  }

  .chapter-time-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
  }

  .chapter-pill-title {
    font-family: var(--font-serif);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .chapter-pill-creator {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .inside-shelf-more-row {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px dashed var(--border);
  }

  .link-preview-more {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--vol-color);
    cursor: pointer;
    padding: 2px 0;
    text-align: left;
  }

  .link-preview-more:hover {
    text-decoration: underline;
  }

  /* Card Action Footer */
  .card-action-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 24px;
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .footer-left-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn-enter-volume {
    display: inline-flex;
    align-items: center;
    background: var(--vol-color);
    color: #fff !important;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .btn-enter-volume:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .btn-toggle-drawer {
    display: inline-flex;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 6px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .btn-toggle-drawer:hover {
    border-color: var(--vol-color);
    color: var(--text-primary);
  }

  .footer-next-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* Full Chapter Index Drawer */
  .volume-full-drawer {
    display: none;
    background: var(--bg-card);
    border-top: 1.5px solid var(--vol-border-light);
    animation: drawerSlide 0.2s ease-out;
  }

  .volume-full-drawer.open {
    display: block;
  }

  @keyframes drawerSlide {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .volume-drawer-inner {
    padding: 20px 24px;
  }

  .drawer-inner-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .drawer-inner-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--vol-color);
  }

  .drawer-close-btn {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
  }

  .drawer-close-btn:hover {
    color: var(--text-primary);
  }

  .drawer-topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }

  .drawer-topic-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .drawer-topic-card:hover {
    border-color: var(--vol-color);
    background: var(--bg-card);
    transform: translateY(-1px);
  }

  .drawer-topic-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .drawer-topic-order {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--vol-color);
  }

  .drawer-topic-time {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .drawer-topic-title {
    font-family: var(--font-serif);
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .drawer-topic-summary {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .drawer-topic-creator {
    font-family: var(--font-sans);
    font-size: 0.72rem;
