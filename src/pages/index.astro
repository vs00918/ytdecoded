---
import ReaderLayout from "../layouts/ReaderLayout.astro";
import { getCollection } from "astro:content";
import { getVolumeGroups } from "../utils/navigation";

// Fetch all topics dynamically from Astro Content Collection
const allTopics = await getCollection("topics");
const rawVolumeGroups = getVolumeGroups(allTopics);

// Compute global corpus metrics dynamically
const totalTopics = allTopics.length;
const totalVolumes = rawVolumeGroups.length;
const totalWordCount = allTopics.reduce((acc, t) => acc + (t.body ? t.body.split(/\s+/).filter(Boolean).length : 0), 0);
const totalReadingHours = (totalWordCount / 225 / 60).toFixed(1);

// Helper for Roman Numerals
function toRoman(num: number): string {
  const lookup: Record<string, number> = {
    M: 1000, CM: 900, D: 500, CD: 400, C: 100, XC: 90,
    L: 50, XL: 40, X: 10, IX: 9, V: 5, IV: 4, I: 1
  };
  let roman = "";
  for (const i in lookup) {
    while (num >= lookup[i]) {
      roman += i;
      num -= lookup[i];
    }
  }
  return roman || "I";
}

// Volume Domain metadata
function getVolumeVisualTheme(title: string, volumeNumber: number) {
  const t = title.toLowerCase();
  if (t.includes("biology") || t.includes("energy") || t.includes("brain") || t.includes("mind")) {
    return {
      key: "biology",
      domainLabel: "COGNITIVE NEUROBIOLOGY & SOMATIC SYSTEMS",
      shortLabel: "Biology of Mind & Energy",
      accentColor: "#2d6a4f",
      accentSoft: "#e8f4ec",
      illustration: "/ytdecoded/assets/volumes/vol1-neurobiology.svg"
    };
  }
  if (t.includes("wealth") || t.includes("capital") || t.includes("allocation") || t.includes("money")) {
    return {
      key: "wealth",
      domainLabel: "CAPITAL DYNAMICS & ASYMMETRIC LEVERAGE",
      shortLabel: "Wealth & Capital Allocation",
      accentColor: "#936639",
      accentSoft: "#f7ede2",
      illustration: "/ytdecoded/assets/volumes/vol2-wealth.svg"
    };
  }
  if (t.includes("philosophy") || t.includes("action") || t.includes("metacognition")) {
    return {
      key: "metacognition",
      domainLabel: "PHILOSOPHY OF ACTION & METACOGNITIVE MASTERY",
      shortLabel: "Philosophy of Action",
      accentColor: "#8a2839",
      accentSoft: "#fcedef",
      illustration: "/ytdecoded/assets/volumes/vol3-metacognition.svg"
    };
  }
  if (t.includes("execution") || t.includes("velocity") || t.includes("leverage")) {
    return {
      key: "execution",
      domainLabel: "EXECUTION PHYSICS & KINETIC SYSTEMS",
      shortLabel: "High-Velocity Execution",
      accentColor: "#a24857",
      accentSoft: "#fbe9eb",
      illustration: "/ytdecoded/assets/volumes/vol4-execution.svg"
    };
  }
  if (t.includes("social") || t.includes("sovereignty") || t.includes("communication")) {
    return {
      key: "social",
      domainLabel: "SOCIAL SOVEREIGNTY & HUMAN DYNAMICS",
      shortLabel: "Social Sovereignty",
      accentColor: "#3b4d6b",
      accentSoft: "#e9eef5",
      illustration: "/ytdecoded/assets/volumes/vol5-social.svg"
    };
  }
  if (t.includes("existential") || t.includes("purpose") || t.includes("summit")) {
    return {
      key: "existential",
      domainLabel: "EXISTENTIAL PHILOSOPHY & THE SUMMIT",
      shortLabel: "Existential Sovereignty",
      accentColor: "#2c3e6b",
      accentSoft: "#e8ecf8",
      illustration: "/ytdecoded/assets/volumes/vol6-summit.svg"
    };
  }
  return {
    key: "general",
    domainLabel: "FOUNDATIONAL SYSTEMS & COGNITION",
    shortLabel: "Foundational Systems",
    accentColor: "#4a5568",
    accentSoft: "#edf2f7",
    illustration: "/ytdecoded/assets/volumes/vol1-neurobiology.svg"
  };
}

// Volume Thesis / Core Premise
function getVolumeThesis(volumeNumber: number): string {
  const knownTheses: Record<number, string> = {
    1: "Physical and neurological foundations of peak cognition: gut-brain signaling, dopamine regulation, sleep architecture, and attentional sovereignty.",
    2: "The structural mechanics of capital compounding, predictable cashflow reinvestment, and the true cost of debt.",
    3: "The psychology of internal sovereignty: dismantling procrastination, mastering metacognition, and executing sustainable deep work.",
    4: "The operational physics of deliberate action: overcoming homeostatic comfort, resisting safety bias, and building progressive friction.",
    5: "Structural analysis of human interaction: status games, interpersonal power, communicative empathy, and game-theoretic trust.",
    6: "Existential resilience and philosophical sovereignty: affect labeling, Stoic endurance, active nihilism, and radical self-overcoming."
  };
  return knownTheses[volumeNumber] || "Syntopical chapters exploring first-principles frameworks, mental models, and sovereign mastery.";
}

// "READ THIS IF..." — One concise sentence derived directly from syllabus
function getVolumeReadThisIf(volumeNumber: number): string {
  const readThisIfMap: Record<number, string> = {
    1: "Read this if you want to understand the biological engines of your energy, focus, sleep, and mental clarity.",
    2: "Read this if you want to understand how predictable cashflow compounds and why debt erodes financial sovereignty.",
    3: "Read this if you struggle with procrastination, overthinking, or turning conceptual knowledge into daily disciplined execution.",
    4: "Read this if you find yourself paralyzed by comfortable routines and need the operational physics to act under friction.",
    5: "Read this if you want to navigate social hierarchies, speak with resonance, deconstruct imposter syndrome, and build trust.",
    6: "Read this if you face existential doubt, emotional turbulence, or crisis, and seek unshakeable internal grounding."
  };
  return readThisIfMap[volumeNumber] || "Read this if you want to ground your thinking in sovereign first-principles models.";
}

// "THE JOURNEY" — Compact conceptual progression steps
function getVolumeJourney(volumeNumber: number): string[] {
  const journeyMap: Record<number, string[]> = {
    1: ["Gut–Brain Axis", "Dopamine Chemistry", "Impulse Control", "Neural Rewiring", "Sleep Architecture", "Biopsychosocial Mind"],
    2: ["Cashflow Fundamentals", "Cost of Debt", "Capital Compounding", "Asset Sovereignty"],
    3: ["Activation Energy", "Habit Cascades", "Metacognition & Biases", "Active Recall", "Circadian Cadence", "First-Principles Outworking"],
    4: ["Homeostatic Trap", "Paradox of Safety", "Progressive Friction", "Kinetic Action"],
    5: ["Social Fictions", "Front-Stage Fallacy", "Vocal Resonance", "Supercommunication", "Game Theory & Trust", "Civilizational Critique"],
    6: ["Affect Labeling", "True Confidence", "Radical Self-Ownership", "Marcus Aurelius's Citadel", "Nietzschean Overcoming", "Relational Maturity"]
  };
  return journeyMap[volumeNumber] || ["Foundations", "Mechanisms", "Applied Practice", "Sovereign Mastery"];
}

// Reading Scale indicator classifier
function getVolumeScale(totalMin: number): { label: string; filledBlocks: number; totalBlocks: number } {
  if (totalMin <= 15) {
    return { label: "CONCISE", filledBlocks: 2, totalBlocks: 8 };
  } else if (totalMin <= 50) {
    return { label: "MODERATE", filledBlocks: 4, totalBlocks: 8 };
  } else if (totalMin <= 80) {
    return { label: "SUBSTANTIAL", filledBlocks: 6, totalBlocks: 8 };
  } else {
    return { label: "COMPREHENSIVE", filledBlocks: 8, totalBlocks: 8 };
  }
}

// Curated 3-4 Representative Preview Chapters per volume
const PREVIEW_SLUGS: Record<number, string[]> = {
  1: [
    "the-second-brain-and-the-gut-mind-axis",
    "the-neurochemistry-of-focus-and-dopamine-transition",
    "the-neurobiology-of-sleep-architecture"
  ],
  2: [
    "the-engine-of-wealth-and-capital-allocation"
  ],
  3: [
    "eliminating-procrastination-and-activation-energy",
    "the-architecture-of-memory-and-active-recall",
    "the-anatomy-of-consistency-and-forced-action",
    "the-physics-of-outworking-and-first-principles"
  ],
  4: [
    "the-pathology-of-comfort-and-progressive-friction"
  ],
  5: [
    "the-front-stage-fallacy-and-imposter-syndrome",
    "the-architecture-of-resonance-and-vocal-sovereignty",
    "the-architecture-of-supercommunication",
    "game-theory-and-strategic-cooperation"
  ],
  6: [
    "the-architecture-of-emotional-granularity",
    "the-architecture-of-true-confidence",
    "the-inner-citadel-and-stoic-sovereignty",
    "the-will-to-power-and-self-overcoming"
  ]
};

// Process all volumes for the reading decision system
const volumeCards = rawVolumeGroups.map((group) => {
  const volumeNumber = group.volume;
  const romanVol = toRoman(volumeNumber);
  const visualTheme = getVolumeVisualTheme(group.volumeTitle, volumeNumber);
  const thesis = getVolumeThesis(volumeNumber);
  const readThisIf = getVolumeReadThisIf(volumeNumber);
  const journey = getVolumeJourney(volumeNumber);

  const volMinutes = group.topics.reduce((acc, t) => acc + (t.data.reading_time_minutes || Math.max(1, Math.ceil((t.body?.split(/\s+/).filter(Boolean).length || 0) / 225))), 0);
  const scale = getVolumeScale(volMinutes);
  const isFlagship = volumeNumber === 3;

  const processedTopics = group.topics.map((t: any) => {
    const readingTime = t.data.reading_time_minutes || Math.max(1, Math.ceil((t.body?.split(/\s+/).filter(Boolean).length || 0) / 225));
    const creator = t.data.sources && t.data.sources.length > 0 ? t.data.sources[0].creator : null;
    return {
      topic: t,
      readingTime,
      creator,
      summary: t.data.summary_15s || ""
    };
  });

  const targetSlugs = PREVIEW_SLUGS[volumeNumber] || [];
  // Sort volume topics by recency
  const volTopicsByRecency = [...processedTopics].sort((a, b) => {
    const dateA = a.topic.data.last_updated || '2026-09-01';
    const dateB = b.topic.data.last_updated || '2026-09-01';
    if (dateB !== dateA) return dateB.localeCompare(dateA);
    return (b.topic.data.order_in_volume || 0) - (a.topic.data.order_in_volume || 0);
  });

  // Guarantee the newest addition in this volume is in previewTopics, alongside target slugs
  let selected = processedTopics.filter(item => targetSlugs.includes(item.topic.slug));
  if (volTopicsByRecency.length > 0 && !selected.some(item => item.topic.slug === volTopicsByRecency[0].topic.slug)) {
    selected.unshift(volTopicsByRecency[0]);
  }
  if (selected.length === 0) {
    selected = processedTopics.slice(0, 3);
  }
  const previewTopics = selected.slice(0, 4);
  const remainingCount = processedTopics.length - previewTopics.length;

  return {
    ...group,
    volumeNumber,
    romanVol,
    visualTheme,
    thesis,
    readThisIf,
    journey,
    volMinutes,
    scale,
    isFlagship,
    processedTopics,
    previewTopics,
    remainingCount
  };
});

// Chronological sort across entire corpus (newest first)
const recentTopics = [...allTopics].sort((a, b) => {
  const dateA = a.data.last_updated || '2026-09-01';
  const dateB = b.data.last_updated || '2026-09-01';
  if (dateB !== dateA) return dateB.localeCompare(dateA);
  if (b.data.volume !== a.data.volume) return b.data.volume - a.data.volume;
  return (b.data.order_in_volume || 0) - (a.data.order_in_volume || 0);
});

const latestDate = recentTopics.length > 0 ? (recentTopics[0].data.last_updated || '') : '';

function formatTopicDate(dateStr?: string): string {
  if (!dateStr) return 'Sep 2026';
  const parts = dateStr.split('-');
  if (parts.length === 3) {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const mIdx = parseInt(parts[1], 10) - 1;
    const day = parseInt(parts[2], 10);
    return `${day} ${months[mIdx] || 'Sep'} ${parts[0]}`;
  }
  return dateStr;
}
---

<ReaderLayout title="Reading Map" description="The Living Codex — Master Reading Decision System & Knowledge Map" isWideLayout={true} hideNavSearch={true}>
