import ReaderLayout from '../layouts/ReaderLayout.astro';
import { getCollection } from 'astro:content';
import { getVolumeGroups } from '../utils/navigation';

// Fetch all topics dynamically from Astro Content Collection
const allTopics = await getCollection('topics');
const rawVolumeGroups = getVolumeGroups(allTopics);

// Compute global corpus metrics dynamically
const totalTopics = allTopics.length;
const totalVolumes = rawVolumeGroups.length;
const totalWordCount = allTopics.reduce((acc, t) => acc + (t.body ? t.body.split(/\s+/).filter(Boolean).length : 0), 0);
const totalReadingHours = (totalWordCount / 225 / 60).toFixed(1);

// Helper for Roman Numerals
function toRoman(num: number): string {
  const lookup: Record<string, number> = {
    M: 1000, CM: 900, D: 500, CD: 400, C: 100, XC: 90,
    L: 50, XL: 40, X: 10, IX: 9, V: 5, IV: 4, I: 1
  };
  let roman = '';
  for (const i in lookup) {
    while (num >= lookup[i]) {
      roman += i;
      num -= lookup[i];
    }
  }
  return roman || 'I';
}

// Dynamic Domain Identity, Colors & Illustrations
function getVolumeVisualTheme(title: string, volumeNumber: number) {
  const t = title.toLowerCase();
  if (t.includes('biology') || t.includes('energy') || t.includes('brain') || t.includes('mind')) {
    return {
      key: 'biology',
      domainLabel: 'COGNITIVE NEUROBIOLOGY & SOMATIC SYSTEMS',
      accentColor: '#2d6a4f',
      accentSoft: '#e8f4ec',
      illustration: '/ytdecoded/assets/volumes/vol1-neurobiology.svg'
    };
  }
  if (t.includes('wealth') || t.includes('capital') || t.includes('allocation') || t.includes('money')) {
    return {
      key: 'wealth',
      domainLabel: 'CAPITAL DYNAMICS & ASYMMETRIC LEVERAGE',
      accentColor: '#936639',
      accentSoft: '#f7ede2',
      illustration: '/ytdecoded/assets/volumes/vol2-wealth.svg'
    };
  }
  if (t.includes('philosophy') || t.includes('action') || t.includes('metacognition')) {
    return {
      key: 'metacognition',
      domainLabel: 'PHILOSOPHY OF ACTION & METACOGNITIVE MASTERY',
      accentColor: '#8a2839',
      accentSoft: '#fcedef',
      illustration: '/ytdecoded/assets/volumes/vol3-metacognition.svg'
    };
  }
  if (t.includes('execution') || t.includes('velocity') || t.includes('leverage')) {
    return {
      key: 'execution',
      domainLabel: 'EXECUTION PHYSICS & KINETIC SYSTEMS',
      accentColor: '#a24857',
      accentSoft: '#fbe9eb',
      illustration: '/ytdecoded/assets/volumes/vol4-execution.svg'
    };
  }
  if (t.includes('social') || t.includes('sovereignty') || t.includes('communication')) {
    return {
      key: 'social',
      domainLabel: 'SOCIAL SOVEREIGNTY & HUMAN DYNAMICS',
      accentColor: '#3b4d6b',
      accentSoft: '#e9eef5',
      illustration: '/ytdecoded/assets/volumes/vol5-social.svg'
    };
  }
  if (t.includes('existential') || t.includes('purpose') || t.includes('summit')) {
    return {
      key: 'existential',
      domainLabel: 'EXISTENTIAL PHILOSOPHY & THE SUMMIT',
      accentColor: '#2c3e6b',
      accentSoft: '#e8ecf8',
      illustration: '/ytdecoded/assets/volumes/vol6-summit.svg'
    };
  }
  
  // Fallback for new future volumes
  const fallbacks = [
    { key: 'alpha', domainLabel: 'THEORETICAL FOUNDATIONS', accentColor: '#7a5901', accentSoft: '#fcf6e8', illustration: '/ytdecoded/assets/volumes/vol2-wealth.svg' },
    { key: 'beta', domainLabel: 'APPLIED SYSTEMS', accentColor: '#3d6375', accentSoft: '#eaf2f5', illustration: '/ytdecoded/assets/volumes/vol4-execution.svg' },
    { key: 'gamma', domainLabel: 'ADVANCED SYNTHESIS', accentColor: '#5c4d7d', accentSoft: '#f1eef8', illustration: '/ytdecoded/assets/volumes/vol6-summit.svg' }
  ];
  return fallbacks[volumeNumber % fallbacks.length];
}

// Dynamic Domain Thesis / Description Synthesizer
function getVolumeThesis(group: { volume: number; volumeTitle: string; topics: any[] }): string {
  const knownTheses: Record<string, string> = {
    'The Biology of Mind & Energy': 'Physical and neurological foundations of peak cognition: dopamine regulation, circadian rhythm, sleep architecture, and the gut-mind axis.',
    'The Architecture of Wealth & Capital Allocation': 'Structural mechanisms of capital compounding, asymmetric leverage, the three currencies of wealth, and long-term asset allocation.',
    'Philosophy of Action & Metacognition': 'The psychology of internal sovereignty: cognitive bias dismantling, emotional granularity, deliberate practice, and the craft-first paradigm.',
    'High-Velocity Execution & Asymmetric Leverage': 'The operational mechanics of deliberate action: conquering activation energy, eliminating procrastination, and high-agency execution.',
    'The Architecture of Social Sovereignty': 'Structural analysis of modern human dynamics, difficult conversations, deception detection, the dramaturgical front stage, and relational empathy.',
    'Existential Sovereignty, Purpose & The Summit': 'Radical resilience, existential philosophy, and classical critiques of societal systems from ancient Athens to the Anthropocene.'
  };

  if (knownTheses[group.volumeTitle]) {
    return knownTheses[group.volumeTitle];
  }

  // Synthesize dynamically from constituent topic metadata
  const tags = Array.from(new Set(group.topics.flatMap((t: any) => t.data.tags || []))).slice(0, 4);
  if (tags.length > 0) {
    return `Comprehensive treatises and first-principles mental models exploring ${tags.join(', ')}.`;
  }
  return 'Syntopical chapters exploring first-principles frameworks, mental models, and sovereign mastery.';
}

// Process all volumes dynamically
const volumeCards = rawVolumeGroups.map((group) => {
  const volumeNumber = group.volume;
  const romanVol = toRoman(volumeNumber);
  const visualTheme = getVolumeVisualTheme(group.volumeTitle, volumeNumber);
  const thesis = getVolumeThesis(group);

  const volWordCount = group.topics.reduce((acc, t) => acc + (t.body ? t.body.split(/\s+/).filter(Boolean).length : 0), 0);
  const volReadingTime = Math.max(1, Math.ceil(volWordCount / 225));

  // Determine grid row position based on volume characteristics (Vol 3 is Full-Width Hero)
  const isHeroRow = group.volume === 3 || group.topics.length >= 16;
  const isHalfRow = !isHeroRow && (group.volume === 1 || group.volume === 2);
  const isThirdRow = !isHeroRow && (group.volume >= 4);

  // Extract unique thinkers/creators
  const uniqueCreators = Array.from(
    new Set(group.topics.flatMap((t: any) => t.data.sources?.map((s: any) => s.creator) || []).filter(Boolean) as string[])
  );

  // Calculate topic list
  const processedTopics = group.topics.map((t: any) => {
    const wordCount = t.body ? t.body.split(/\s+/).filter(Boolean).length : 0;
    const readingTime = Math.max(1, Math.ceil(wordCount / 225));
    const creator = t.data.sources && t.data.sources.length > 0 ? t.data.sources[0].creator : null;
    return {
      topic: t,
      readingTime,
      creator
    };
  });

  // Display top 1-2 featured topics to ensure uniform height across sibling cards in the same line
  const previewCount = isHeroRow ? 2 : Math.min(group.topics.length, 2);
  const previewTopics = processedTopics.slice(0, previewCount);
  const remainingCount = group.topics.length - previewCount;

  return {
    ...group,
    volumeNumber,
    romanVol,
    visualTheme,
    thesis,
    volReadingTime,
    isHeroRow,
    isHalfRow,
    isThirdRow,
    uniqueCreators,
    processedTopics,
    previewTopics,
    remainingCount
  };
});
---

<ReaderLayout title="Library Catalog" description="The Living Codex — Master Personal Knowledge Library" isWideLayout={true} hideNavSearch={true}>
  <div class="library-app-canvas">
    
    <!-- ====================================================================
         HERO SECTION: EDITORIAL BANNER & SEARCH
         ==================================================================== -->
    <header class="codex-hero-section">
      <div class="hero-badge-pill">
        <span class="hero-badge-bold">LIVING CODEX</span>
        <span class="hero-badge-dot">•</span>
        <span class="hero-badge-light">PERSONAL KNOWLEDGE LIBRARY</span>
      </div>

      <h1 class="codex-hero-title">The Living Codex</h1>
      
      <p class="codex-hero-subtitle">
        Sovereign first-principles frameworks, cognitive mechanisms & mental models distilled from rigorous masterclasses into permanent, interconnected knowledge.
      </p>

      <!-- Prominent Library Search Trigger Field -->
      <div class="codex-search-wrap">
        <button 
          id="library-search-btn" 
          class="codex-search-input-btn" 
          aria-label="Open Search across the Living Codex"
          title="Search the Living Codex (Press /)"
        >
          <span class="search-icon-svg" aria-hidden="true">🔍</span>
          <span class="search-placeholder-text">Search knowledge, mental models, mechanisms, or authors...</span>
          <kbd class="search-shortcut-key">/</kbd>
        </button>
      </div>
    </header>

    <!-- ====================================================================
         SECTION 2: CONTINUE STUDYING (Dynamic from localStorage)
         ==================================================================== -->
    <section id="continue-reading-section" class="continue-study-section" style="display: none;" aria-label="Continue Studying">
      <div class="continue-study-banner">
        <div class="continue-study-left">
          <div class="continue-book-icon-box">
            <span aria-hidden="true">📖</span>
          </div>
          <div class="continue-meta-content">
            <div class="continue-label-tag">CONTINUE STUDYING</div>
            <h2 id="continue-reading-title" class="continue-topic-title">The Architecture of Memory and Active Recall</h2>
            <div class="continue-progress-row">
              <div class="continue-progress-bar-track">
                <div class="continue-progress-bar-fill" style="width: 72%;"></div>
              </div>
              <span class="continue-progress-percent">72%</span>
            </div>
          </div>
        </div>

        <div class="continue-study-right">
          <a id="continue-reading-link" href="#" class="continue-resume-btn">
            Resume Reading →
          </a>
          <button id="dismiss-continue-btn" class="continue-dismiss-link">
            ✕ Dismiss
          </button>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 3: KNOWLEDGE VOLUMES CATALOG (DIRECTLY BELOW SEARCH BAR)
         ==================================================================== -->
    <main class="codex-catalog-section" aria-label="Knowledge Volumes Catalog">
      <!-- Compact Top Control Bar Directly Above Cards -->
      <div class="catalog-header-row">
        <div class="catalog-title-group">
          <h2 class="catalog-heading">Knowledge Volumes</h2>
          <span class="catalog-caption-inline">Explore the foundational bodies of thought</span>
        </div>
        <div class="catalog-control-buttons">
          <button id="expand-all-btn" class="catalog-action-btn" title="Expand all volume drawers">
            <span class="action-icon">⛶</span> Expand All Shelves
          </button>
          <button id="collapse-all-btn" class="catalog-action-btn" title="Collapse all volume drawers">
            <span class="action-icon">−</span> Collapse Shelves
          </button>
        </div>
      </div>

      <!-- Symmetric Shelves Grid Directly Positioned -->
      <div class="editorial-shelves-grid">
        {volumeCards.map((vol) => (
          <article 
            class={`editorial-volume-card ${vol.isHeroRow ? 'card-hero-span' : vol.isHalfRow ? 'card-half-span' : 'card-third-span'}`}
            id={`volume-card-${vol.volumeNumber}`}
            style={`--vol-color: ${vol.visualTheme.accentColor}; --vol-soft: ${vol.visualTheme.accentSoft};`}
            aria-labelledby={`vol-title-${vol.volumeNumber}`}
          >
            <!-- Card Frame -->
            <div class="editorial-card-frame">
              
              <!-- Top Domain Header Banner -->
              <div class="card-domain-header">
                <div class="domain-vol-badge">
                  <span class="vol-label-text">VOL.</span>
                  <span class="vol-num-text">{vol.romanVol}</span>
                </div>
                <div class="domain-title-text">{vol.visualTheme.domainLabel}</div>
              </div>

              <!-- Card Body: Split Artwork Panel & Content Panel -->
              <div class={`card-split-body ${vol.isHeroRow ? 'body-hero-split' : ''}`}>
                
                <!-- Left Thematic Artwork Panel -->
                <div class="card-artwork-panel">
                  <img 
                    src={vol.visualTheme.illustration} 
                    alt={`${vol.volumeTitle} Thematic Illustration`}
                    class="artwork-img"
                    loading="lazy"
                  />
                </div>

                <!-- Right Content Panel -->
                <div class="card-content-panel">
                  <div class="content-panel-top">
                    <h3 id={`vol-title-${vol.volumeNumber}`} class="card-volume-title" title={vol.volumeTitle}>
                      <a href={`/ytdecoded/volumes/${vol.volumeNumber}/`} class="card-title-link">
                        {vol.volumeTitle}
                      </a>
                    </h3>

                    <p class="card-volume-thesis">{vol.thesis}</p>
                  </div>

                  <div class="content-panel-bottom">
                    <div class="card-meta-indicators">
                      <span class="meta-item"><strong>{vol.topics.length}</strong> {vol.topics.length === 1 ? 'Topic' : 'Topics'}</span>
                      <span class="meta-item-sep">⏱️</span>
                      <span class="meta-item"><strong>{vol.volReadingTime}m</strong></span>
                    </div>

                    <!-- Compact Featured Topic Shelf (Uniform Size) -->
                    <div class="card-featured-shelf">
                      <div class="featured-shelf-title">
                        {vol.topics.length === 1 ? 'FEATURED TOPIC' : 'FEATURED TOPICS'}
                      </div>
                      <ul class="featured-topics-list">
                        {vol.previewTopics.map(({ topic: t }) => (
                          <li class="featured-topic-item">
                            <a href={`/ytdecoded/topics/${t.slug}/`} class="featured-topic-link">
                              <span class="topic-hash">#{t.data.order_in_volume}</span>
                              <span class="topic-name">{t.data.title}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                      {vol.remainingCount > 0 && (
                        <div class="featured-remaining-text">
                          + {vol.remainingCount} {vol.remainingCount === 1 ? 'more' : 'more in volume'}
                        </div>
                      )}
                    </div>
                  </div>
                </div>

              </div>

              <!-- Card Bottom Action Bar -->
              <footer class="card-action-footer">
                <a 
                  href={`/ytdecoded/volumes/${vol.volumeNumber}/`} 
                  class="btn-enter-volume"
                  title={`Enter Volume ${vol.romanVol}`}
                >
                  Enter ({vol.topics.length}) →
                </a>

                <button 
                  type="button"
                  class="btn-shelf-drawer" 
                  id={`toggle-btn-${vol.volumeNumber}`}
                  data-count={vol.topics.length}
                  aria-expanded="false"
                  aria-controls={`drawer-${vol.volumeNumber}`}
                  onclick={`toggleShelfDrawer(${vol.volumeNumber})`}
                >
                  <span class="drawer-btn-label">All {vol.topics.length} {vol.topics.length === 1 ? 'Topic' : 'Topics'}</span>
                </button>
              </footer>

              <!-- Collapsible Full Topic Drawer -->
              <div 
                id={`drawer-${vol.volumeNumber}`} 
                class="volume-full-drawer"
                aria-hidden="true"
              >
                <div class="volume-drawer-inner">
                  <div class="drawer-topics-grid">
                    {vol.processedTopics.map(({ topic: t, readingTime, creator }) => (
                      <a href={`/ytdecoded/topics/${t.slug}/`} class="drawer-topic-card">
                        <div class="drawer-topic-header">
                          <span class="drawer-topic-order">#{t.data.order_in_volume}</span>
                          <span class="drawer-topic-time">⏱️ {readingTime}m</span>
                        </div>
                        <div class="drawer-topic-title">{t.data.title}</div>
                        {t.data.summary_15s && (
                          <div class="drawer-topic-summary">{t.data.summary_15s}</div>
                        )}
                        {creator && (
                          <div class="drawer-topic-creator">Mind: <strong>{creator}</strong></div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
    </main>

    <!-- ====================================================================
         SECTION 4: BOTTOM CORPUS METRIC STRIP (MOVED TO BOTTOM)
         ==================================================================== -->
    <section class="bottom-corpus-stat-section" aria-label="Codex Overview Statistics">
      <div class="codex-stat-strip">
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">📖</span>
          <div class="stat-info">
            <span class="stat-num">{totalVolumes}</span>
            <span class="stat-name">Volumes</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">🗂️</span>
          <div class="stat-info">
            <span class="stat-num">{totalTopics}</span>
            <span class="stat-name">Topics</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">⏱️</span>
          <div class="stat-info">
            <span class="stat-num">~{totalReadingHours}</span>
            <span class="stat-name">Hours of Study</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon stat-accent-icon" aria-hidden="true">⚡</span>
          <div class="stat-info">
            <span class="stat-badge-text">Offline Semantic Index</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 5: QUOTE FOOTER
         ==================================================================== -->
    <footer class="codex-quote-banner">
      <div class="quote-content-wrap">
        <span class="quote-symbol" aria-hidden="true">❝</span>
        <span class="quote-text">Knowledge is power only when it is understood, internalized, and applied.</span>
        <span class="quote-author">— The Living Codex</span>
      </div>
    </footer>

  </div>
</ReaderLayout>

<style>
  /* ==========================================================================
     LIVING CODEX: STREAMLINED EDITORIAL KNOWLEDGE CATALOG
     ========================================================================== */

  .library-app-canvas {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6px 14px 40px 14px;
    font-family: var(--font-body);
  }

  /* --------------------------------------------------------------------------
     HERO SECTION (COMPACT TIGHT FLOW)
     -------------------------------------------------------------------------- */
  .codex-hero-section {
    text-align: center;
    padding: 12px 12px 14px 12px;
    margin-bottom: 8px;
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2px 10px;
    margin-bottom: 8px;
  }

  .hero-badge-bold {
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .hero-badge-dot {
    color: var(--text-muted);
    font-size: 0.64rem;
  }

  .hero-badge-light {
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .codex-hero-title {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 6px;
    letter-spacing: -0.02em;
  }

  @media (max-width: 768px) {
    .codex-hero-title {
      font-size: 2rem;
    }
  }

  .codex-hero-subtitle {
    max-width: 600px;
    margin: 0 auto 14px auto;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  /* Search Input Field */
  .codex-search-wrap {
    max-width: 580px;
    margin: 0 auto;
  }

  .codex-search-input-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 16px;
    cursor: pointer;
    box-shadow: 0 2px 8px var(--shadow);
    transition: all 0.15s ease;
    text-align: left;
  }

  .codex-search-input-btn:hover, .codex-search-input-btn:focus-visible {
    border-color: var(--accent);
    background: var(--bg-surface);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--shadow);
  }

  .search-icon-svg {
    font-size: 1rem;
    opacity: 0.75;
  }

  .search-placeholder-text {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .search-shortcut-key {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 6px;
    color: var(--text-muted);
  }

  /* --------------------------------------------------------------------------
     CONTINUE STUDYING SECTION
     -------------------------------------------------------------------------- */
  .continue-study-section {
    margin-top: 14px;
    margin-bottom: 16px;
  }

  .continue-study-banner {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 16px;
    box-shadow: 0 2px 6px var(--shadow);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }

  .continue-study-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 240px;
  }

  .continue-book-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--accent);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .continue-meta-content {
    flex: 1;
  }

  .continue-label-tag {
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .continue-topic-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 3px;
  }

  .continue-progress-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .continue-progress-bar-track {
    flex: 1;
    max-width: 180px;
    height: 5px;
    background: var(--border-subtle);
    border-radius: 3px;
    overflow: hidden;
  }

  .continue-progress-bar-fill {
    height: 100%;
    background: #2d6a4f;
    border-radius: 3px;
  }

  .continue-progress-percent {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .continue-study-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .continue-resume-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--accent);
    color: #ffffff !important;
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  .continue-resume-btn:hover {
    opacity: 0.9;
    transform: translateX(1px);
  }

  .continue-dismiss-link {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.72rem;
