---
import ReaderLayout from '../layouts/ReaderLayout.astro';
import { getCollection } from 'astro:content';
import { getVolumeGroups } from '../utils/navigation';

const allTopics = await getCollection('topics');
const rawVolumeGroups = getVolumeGroups(allTopics);
const totalChapters = allTopics.length;
const totalVolumes = rawVolumeGroups.length;

// Curated intellectual domain theses for each canonical volume
const volumeTheses: Record<number, string> = {
  1: "Physical and neurological foundations of peak cognition: dopamine regulation, sleep architecture, and the gut-mind axis.",
  2: "The operational mechanics of deliberate action: overcoming activation energy, eliminating procrastination, and high-agency execution.",
  3: "The psychology of internal mastery: breaking overthinking loops, managing hedonic adaptation, and emotional granularity.",
  4: "Pedagogical and rhetorical mastery: systems for high-impact communication, conceptual resonance, and rapid comprehension.",
  5: "Structural analysis of modern institutions, status games, epistemic firewalls, and asymmetric wealth accumulation engines.",
  6: "Radical resilience, existential philosophy, and classical critiques of societal systems from ancient Athens to the Anthropocene."
};

// Compute all volume metrics in frontmatter
const volumeGroups = rawVolumeGroups.map((group) => {
  const thesis = volumeTheses[group.volume] || "Syntopical chapters exploring first-principles frameworks.";
  const volWordCount = group.topics.reduce((acc, t) => acc + (t.body ? t.body.split(/\s+/).filter(Boolean).length : 0), 0);
  const volReadingTime = Math.max(1, Math.ceil(volWordCount / 225));
  const uniqueCreators = Array.from(
    new Set(group.topics.flatMap((t: any) => t.data.sources?.map((s: any) => s.creator) || []).filter(Boolean) as string[])
  );
  const isInitiallyOpen = group.topics.length <= 2;
  const processedTopics = group.topics.map((t: any) => {
    const wordCount = t.body ? t.body.split(/\s+/).filter(Boolean).length : 0;
    const readingTime = Math.max(1, Math.ceil(wordCount / 225));
    const creator = t.data.sources && t.data.sources.length > 0 ? t.data.sources[0].creator : null;
    return {
      topic: t,
      readingTime,
      creator
    };
  });

  return {
    ...group,
    thesis,
    volReadingTime,
    uniqueCreators,
    isInitiallyOpen,
    processedTopics
  };
});
---

<ReaderLayout title="Knowledge Library" description="The Living Codex — Master Personal Knowledge Base">
  <div class="library-container">
    
    <!-- ====================================================================
         SECTION 1: HERO & EXPLORATION ORIENTATION
         ==================================================================== -->
    <header class="library-hero">
      <div class="library-badge">Personal Knowledge Library</div>
      <h1 class="library-title">The Living Codex</h1>
      <p class="library-subtitle">
        A sovereign repository of first-principles mental models, cognitive mechanisms, and lifelong execution frameworks distilled from world-class masterclasses.
      </p>

      <!-- Prominent Library Search Trigger (Triggers Pagefind Search Modal) -->
      <div class="library-search-wrap">
        <button 
          id="library-search-btn" 
          class="library-search-btn" 
          aria-label="Open Search across the Living Codex"
          title="Search the Living Codex (Press /)"
        >
          <span class="search-btn-icon" aria-hidden="true">🔍</span>
          <span class="search-btn-text">Search topics, mental models, mechanisms, or authors...</span>
          <kbd class="nav-kbd">/</kbd>
        </button>
      </div>

      <!-- Live Corpus Stat Strip -->
      <div class="library-stats-strip">
        <span>📚 <strong>{totalVolumes}</strong> Knowledge Volumes</span>
        <span class="stat-dot" aria-hidden="true">•</span>
        <span>📖 <strong>{totalChapters}</strong> Syntopical Chapters</span>
        <span class="stat-dot" aria-hidden="true">•</span>
        <span>⚡ Offline Full-Text Index</span>
      </div>
    </header>

    <!-- ====================================================================
         SECTION 2: CONTINUE READING (Dynamic via localStorage)
         ==================================================================== -->
    <section id="continue-reading-section" class="continue-reading-section" style="display: none;" aria-label="Continue Reading">
      <div class="continue-reading-card">
        <div class="continue-reading-header">
          <span class="continue-reading-tag">⚡ CONTINUE STUDYING</span>
          <button id="dismiss-continue-btn" class="dismiss-continue-btn" aria-label="Dismiss Continue Reading Card">✕</button>
        </div>
        <div class="continue-reading-content">
          <h2 id="continue-reading-title" class="continue-reading-title">Topic Title</h2>
          <p id="continue-reading-summary" class="continue-reading-summary">Topic summary...</p>
        </div>
        <a id="continue-reading-link" href="#" class="continue-reading-btn">
          Resume Reading →
        </a>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 3: KNOWLEDGE SHELVES (The 6 Collapsible Volume Folios)
         ==================================================================== -->
    <main class="library-shelves-section" aria-label="Knowledge Volumes">
      <div class="shelves-header">
        <div>
          <h2 class="shelves-title">Knowledge Volumes</h2>
          <span class="shelves-subtitle">Explore the curriculum across all 6 foundational shelves</span>
        </div>
        <div class="shelves-global-controls">
          <button id="expand-all-btn" class="shelves-control-btn" title="Expand all volume drawers">
            ▾ Expand All
          </button>
          <button id="collapse-all-btn" class="shelves-control-btn" title="Collapse all volume drawers">
            ▴ Collapse All
          </button>
        </div>
      </div>

      <div class="shelves-list">
        {volumeGroups.map((group) => (
          <section class="shelf-folio-card" id={`volume-card-${group.volume}`} aria-labelledby={`vol-heading-${group.volume}`}>
            <!-- Folio Overview (Always Visible) -->
            <div class="shelf-folio-header">
              <div class="shelf-folio-meta">
                <span class="shelf-vol-badge">Volume {group.volume}</span>
                <h3 id={`vol-heading-${group.volume}`} class="shelf-vol-title">
                  <a href={`/ytdecoded/volumes/${group.volume}/`} class="shelf-vol-link" title="Open Continuous Volume Reader">
                    {group.volumeTitle}
                  </a>
                </h3>
              </div>

              <p class="shelf-vol-thesis">{group.thesis}</p>

              <div class="shelf-vol-metrics">
                <span>📖 <strong>{group.topics.length}</strong> {group.topics.length === 1 ? 'Chapter' : 'Chapters'}</span>
                <span class="meta-dot" aria-hidden="true">•</span>
                <span>⏱️ <strong>{group.volReadingTime}</strong> min total</span>
                {group.uniqueCreators.length > 0 && (
                  <>
                    <span class="meta-dot" aria-hidden="true">•</span>
                    <span class="shelf-vol-authors">
                      🧠 {group.uniqueCreators.slice(0, 3).join(', ')}{group.uniqueCreators.length > 3 ? ` +${group.uniqueCreators.length - 3}` : ''}
                    </span>
                  </>
                )}
              </div>

              <!-- Folio Action Buttons -->
              <div class="shelf-folio-actions">
                <a 
                  href={`/ytdecoded/volumes/${group.volume}/`} 
                  class="shelf-read-volume-btn"
                  title="Read full volume on a single scrollable page without expanding"
                >
                  📖 Read Full Volume ({group.topics.length} Ch) →
                </a>

                <button 
                  type="button"
                  class="shelf-drawer-toggle-btn" 
                  id={`toggle-btn-${group.volume}`}
                  data-count={group.topics.length}
                  aria-expanded={group.isInitiallyOpen ? "true" : "false"}
                  aria-controls={`drawer-${group.volume}`}
                  onclick={`toggleShelfDrawer(${group.volume})`}
                  title="Browse individual chapter cards"
                >
                  <span class="toggle-icon">{group.isInitiallyOpen ? '▴' : '▾'}</span>
                  <span class="toggle-label">{group.isInitiallyOpen ? 'Hide Chapters' : `Browse ${group.topics.length} Chapters`}</span>
                </button>
              </div>
            </div>

            <!-- Collapsible Chapter Drawer -->
            <div 
              id={`drawer-${group.volume}`} 
              class={`shelf-chapters-drawer ${group.isInitiallyOpen ? 'open' : ''}`}
              aria-hidden={group.isInitiallyOpen ? "false" : "true"}
            >
              <div class="shelf-drawer-inner">
                <div class="shelf-topics-grid">
                  {group.processedTopics.map(({ topic: t, readingTime, creator }) => (
                    <a href={`/ytdecoded/topics/${t.slug}/`} class="shelf-topic-card">
                      <div class="shelf-topic-header">
                        <span class="shelf-topic-order">#{t.data.order_in_volume}</span>
                        <span class="shelf-topic-time">⏱️ {readingTime}m</span>
                      </div>
                      <div class="shelf-topic-title">{t.data.title}</div>
                      {t.data.summary_15s && (
                        <div class="shelf-topic-summary">{t.data.summary_15s}</div>
                      )}
                      {creator && (
                        <div class="shelf-topic-source">By <strong>{creator}</strong></div>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </section>
        ))}
      </div>
    </main>

  </div>
</ReaderLayout>

<script is:inline>
  // Setup Search Button click to open Search Modal
  document.addEventListener('DOMContentLoaded', () => {
    const searchBtn = document.getElementById('library-search-btn');
    if (searchBtn) {
      searchBtn.addEventListener('click', () => {
        if (window.openCodexSearch) {
          window.openCodexSearch();
        } else {
          const globalSearchTrigger = document.getElementById('search-trigger-btn');
          if (globalSearchTrigger) globalSearchTrigger.click();
        }
      });
    }

    // Client-side Continue Reading restoration from localStorage
    try {
      const saved = localStorage.getItem('codex-last-read');
      if (saved) {
        const item = JSON.parse(saved);
        const section = document.getElementById('continue-reading-section');
        const titleEl = document.getElementById('continue-reading-title');
        const summaryEl = document.getElementById('continue-reading-summary');
        const linkEl = document.getElementById('continue-reading-link');

        if (section && titleEl && summaryEl && linkEl && item.slug) {
          titleEl.innerText = item.title || 'Continue Reading';
          summaryEl.innerText = item.summary || 'Resume your study where you left off.';
          linkEl.href = `/ytdecoded/topics/${item.slug}/`;
          section.style.display = 'block';
        }
      }
    } catch (_) {}

    const dismissBtn = document.getElementById('dismiss-continue-btn');
    if (dismissBtn) {
      dismissBtn.addEventListener('click', () => {
        const section = document.getElementById('continue-reading-section');
        if (section) section.style.display = 'none';
      });
    }

    // Global Expand All / Collapse All handlers
    const expandAllBtn = document.getElementById('expand-all-btn');
    const collapseAllBtn = document.getElementById('collapse-all-btn');

    if (expandAllBtn) {
      expandAllBtn.addEventListener('click', () => {
        document.querySelectorAll('.shelf-chapters-drawer').forEach((drawer) => {
          drawer.classList.add('open');
          drawer.setAttribute('aria-hidden', 'false');
        });
        document.querySelectorAll('.shelf-drawer-toggle-btn').forEach((btn) => {
          btn.setAttribute('aria-expanded', 'true');
          const icon = btn.querySelector('.toggle-icon');
          const label = btn.querySelector('.toggle-label');
          if (icon) icon.innerText = '▴';
          if (label) label.innerText = 'Hide Chapters';
        });
      });
    }

    if (collapseAllBtn) {
      collapseAllBtn.addEventListener('click', () => {
        document.querySelectorAll('.shelf-chapters-drawer').forEach((drawer) => {
          drawer.classList.remove('open');
          drawer.setAttribute('aria-hidden', 'true');
        });
        document.querySelectorAll('.shelf-drawer-toggle-btn').forEach((btn) => {
          btn.setAttribute('aria-expanded', 'false');
          const icon = btn.querySelector('.toggle-icon');
          const label = btn.querySelector('.toggle-label');
          if (icon) icon.innerText = '▾';
          if (label) {
            const count = btn.getAttribute('data-count') || '';
            label.innerText = count ? `Browse ${count} Chapters` : 'Browse Chapters';
          }
        });
      });
    }
  });

  // Individual Drawer Toggle Function
  window.toggleShelfDrawer = function(volNum) {
    const drawer = document.getElementById(`drawer-${volNum}`);
    const btn = document.getElementById(`toggle-btn-${volNum}`);
    if (!drawer || !btn) return;

    const isOpen = drawer.classList.contains('open');
    if (isOpen) {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-expanded', 'false');
      const icon = btn.querySelector('.toggle-icon');
      const label = btn.querySelector('.toggle-label');
      const count = btn.getAttribute('data-count') || '';
      if (icon) icon.innerText = '▾';
      if (label) label.innerText = count ? `Browse ${count} Chapters` : 'Browse Chapters';
    } else {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true');
      const icon = btn.querySelector('.toggle-icon');
      const label = btn.querySelector('.toggle-label');
      if (icon) icon.innerText = '▴';
      if (label) label.innerText = 'Hide Chapters';
    }
  };
</script>
