<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Search Trigger Field handler
    const searchBtn = document.getElementById("library-search-btn");
    if (searchBtn) {
      searchBtn.addEventListener("click", () => {
        if (window.openCodexSearch) {
          window.openCodexSearch();
        } else {
          const globalSearchTrigger = document.getElementById("search-trigger-btn");
          if (globalSearchTrigger) globalSearchTrigger.click();
        }
      });
    }

    // Continue Reading restoration from localStorage
    try {
      const saved = localStorage.getItem("codex-last-read");
      if (saved) {
        const item = JSON.parse(saved);
        const section = document.getElementById("continue-reading-section");
        const titleEl = document.getElementById("continue-reading-title");
        const linkEl = document.getElementById("continue-reading-link");

        if (section && titleEl && linkEl && item.slug) {
          titleEl.innerText = item.title || "The Architecture of Memory and Active Recall";
          linkEl.href = `/ytdecoded/topics/${item.slug}/`;
          section.style.display = "block";
        }
      }
    } catch (_) {}

    const dismissBtn = document.getElementById("dismiss-continue-btn");
    if (dismissBtn) {
      dismissBtn.addEventListener("click", () => {
        const section = document.getElementById("continue-reading-section");
        if (section) section.style.display = "none";
      });
    }

    // Global Expand All / Collapse All drawers
    const expandAllBtn = document.getElementById("expand-all-btn");
    const collapseAllBtn = document.getElementById("collapse-all-btn");

    if (expandAllBtn) {
      expandAllBtn.addEventListener("click", () => {
        document.querySelectorAll(".volume-full-drawer").forEach((drawer) => {
          drawer.classList.add("open");
          drawer.setAttribute("aria-hidden", "false");
        });
        document.querySelectorAll(".btn-toggle-drawer").forEach((btn) => {
          btn.setAttribute("aria-expanded", "true");
          const label = btn.querySelector(".drawer-btn-label");
          if (label) label.innerText = "Hide full inventory ▴";
        });
      });
    }

    if (collapseAllBtn) {
      collapseAllBtn.addEventListener("click", () => {
        document.querySelectorAll(".volume-full-drawer").forEach((drawer) => {
          drawer.classList.remove("open");
          drawer.setAttribute("aria-hidden", "true");
        });
        document.querySelectorAll(".btn-toggle-drawer").forEach((btn) => {
          btn.setAttribute("aria-expanded", "false");
          const count = btn.getAttribute("data-count") || "";
          const label = btn.querySelector(".drawer-btn-label");
          if (label) {
            label.innerText = count ? `Full Volume Inventory (${count}) ▾` : "Full Inventory ▾";
          }
        });
      });
    }
  });

  // Toggle individual shelf drawer
  window.toggleShelfDrawer = function(volNum) {
    const drawer = document.getElementById(`drawer-${volNum}`);
    const btn = document.getElementById(`toggle-btn-${volNum}`);
    if (!drawer || !btn) return;

    const isOpen = drawer.classList.contains("open");
    if (isOpen) {
      drawer.classList.remove("open");
      drawer.setAttribute("aria-hidden", "true");
      btn.setAttribute("aria-expanded", "false");
      const count = btn.getAttribute("data-count") || "";
      const label = btn.querySelector(".drawer-btn-label");
      if (label) label.innerText = count ? `Full Volume Inventory (${count}) ▾` : "Full Inventory ▾";
    } else {
      drawer.classList.add("open");
      drawer.setAttribute("aria-hidden", "false");
      btn.setAttribute("aria-expanded", "true");
      const label = btn.querySelector(".drawer-btn-label");
      if (label) label.innerText = "Hide full inventory ▴";
    }
  };

  // Main View Switcher: Chronological Timeline vs Volume Architecture
  window.switchMainView = function(mode) {
    const btnTimeline = document.getElementById('btn-view-timeline');
    const btnVolumes = document.getElementById('btn-view-volumes');
    const glanceSection = document.querySelector('.codex-glance-section');
    const catalogSection = document.querySelector('.codex-catalog-section');

    if (mode === 'volumes') {
      btnTimeline?.classList.remove('active');
      btnTimeline?.setAttribute('aria-selected', 'false');
      btnVolumes?.classList.add('active');
      btnVolumes?.setAttribute('aria-selected', 'true');

      const targetEl = glanceSection || catalogSection;
      if (targetEl) {
        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      try { localStorage.setItem('codex_preferred_view', 'volumes'); } catch (_) {}
    } else {
      btnVolumes?.classList.remove('active');
      btnVolumes?.setAttribute('aria-selected', 'false');
      btnTimeline?.classList.add('active');
      btnTimeline?.setAttribute('aria-selected', 'true');

      const feedSec = document.getElementById('chronological-feed-section');
      if (feedSec) {
        feedSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      try { localStorage.setItem('codex_preferred_view', 'timeline'); } catch (_) {}
    }
  };

  // Toggle Full Chronological Archive Drawer
  window.toggleFullTimeline = function() {
    const drawer = document.getElementById('extended-timeline-drawer');
    const btnText = document.getElementById('timeline-btn-text');
    if (!drawer || !btnText) return;

    if (drawer.style.display === 'none') {
      drawer.style.display = 'block';
      btnText.innerText = 'Collapse Archive ▴';
    } else {
      drawer.style.display = 'none';
      btnText.innerText = 'View Full Chronological Archive ({recentTopics.length} Notes) ▾';
    }
  };
</script>
