  .timeline-expand-row {
    text-align: center;
    margin-top: 8px;
  }

  .timeline-expand-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface);
    border: 1.5px solid var(--border);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    padding: 10px 24px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .timeline-expand-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--bg-card);
  }

  .extended-timeline-drawer {
    margin-top: 12px;
  }

  /* --------------------------------------------------------------------------
     "NOT SURE WHERE TO START?" — 4 DIRECT PATHWAYS
     -------------------------------------------------------------------------- */
  .reading-pathways-section {
    margin-bottom: 32px;
  }

  .pathways-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 20px;
    box-shadow: 0 2px 8px var(--shadow);
  }

  .pathways-label-group {
    margin-bottom: 12px;
  }

  .pathways-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    display: block;
    margin-bottom: 2px;
  }

  .pathways-title {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .pathways-buttons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 10px;
  }

  .pathway-btn {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-left: 3.5px solid var(--btn-accent);
    border-radius: 6px;
    padding: 8px 12px;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .pathway-btn:hover {
    transform: translateY(-1px);
    background: var(--bg-card);
    border-color: var(--btn-accent);
  }

  .pathway-target {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .pathway-dest {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--btn-accent);
    font-weight: 700;
  }

  /* --------------------------------------------------------------------------
     "THE CODEX AT A GLANCE" — READING MAP
     -------------------------------------------------------------------------- */
  .codex-glance-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 40px;
    box-shadow: 0 2px 8px var(--shadow);
  }

  .glance-header {
    margin-bottom: 16px;
  }

  .glance-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .glance-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px;
  }

  .glance-subtitle {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .glance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 10px;
  }

  .glance-card-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--glance-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .glance-card-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px var(--shadow);
    border-color: var(--glance-color);
  }

  .glance-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .glance-vol-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--glance-color);
  }

  .glance-vol-metric {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .glance-vol-title {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .glance-scale-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-top: 4px;
    padding-top: 4px;
    border-top: 1px solid var(--border);
  }

  .glance-scale-meter {
    display: flex;
    gap: 2px;
  }

  .scale-block {
    width: 6px;
    height: 6px;
    background: var(--border);
    border-radius: 1px;
  }

  .scale-block.filled {
    background: var(--glance-color);
  }

  .glance-scale-text {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  /* --------------------------------------------------------------------------
     SECTION 5: CATALOG CONTROL BAR
     -------------------------------------------------------------------------- */
  .codex-catalog-section {
    margin-bottom: 48px;
  }

  .catalog-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 24px;
    border-bottom: 1.5px solid var(--border);
  }

  .catalog-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .catalog-heading {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .catalog-caption-inline {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .catalog-control-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .catalog-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 12px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .catalog-action-btn:hover {
    background: var(--bg-card);
    border-color: var(--accent);
    color: var(--text-primary);
  }

  /* --------------------------------------------------------------------------
     VOLUME DECISION CARDS STACK
     -------------------------------------------------------------------------- */
  .editorial-volumes-stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .editorial-volume-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 4px 14px var(--shadow);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .editorial-volume-card:hover {
    border-color: var(--vol-color);
    box-shadow: 0 6px 20px var(--shadow);
  }

  .card-flagship-featured {
    border-left: 5px solid var(--vol-color);
  }

  .editorial-card-frame {
    display: flex;
    flex-direction: column;
  }

  /* Layer A: What is this? (Domain Header) */
  .card-domain-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 20px;
    background: var(--vol-soft);
    border-bottom: 1px solid var(--vol-border-light);
  }

  .domain-identity-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .domain-vol-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--vol-color);
    flex-shrink: 0;
  }

  .domain-bullet {
    color: var(--vol-color);
    opacity: 0.4;
  }

  .domain-title-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--vol-color);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Layer E: How much? (Reading Load Meter) */
  .domain-badge-scale {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .scale-load-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .reading-load-blocks {
    display: flex;
    gap: 2px;
  }

  .load-block {
    width: 6px;
    height: 8px;
    background: var(--border);
    border-radius: 1px;
  }

  .load-block.filled {
    background: var(--vol-color);
  }

  .scale-dot {
    opacity: 0.4;
  }

  /* Card Split Body */
  .card-split-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    padding: 24px;
  }

  @media (max-width: 860px) {
    .card-split-body {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* Left Artwork Column */
  .card-artwork-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .artwork-plate-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background: var(--vol-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .artwork-img {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    z-index: 1;
    transition: transform 0.2s ease;
  }

  .editorial-volume-card:hover .artwork-img {
    transform: scale(1.04);
  }

  .artwork-watermark-vol {
    position: absolute;
    right: 8px;
    bottom: -4px;
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 900;
    color: var(--vol-color);
    opacity: 0.08;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .content-load-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px 12px;
    text-align: center;
  }

  .load-card-header {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .load-card-status {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--vol-color);
    margin: 2px 0;
  }

  .load-card-details {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Right Content Column */
  .card-content-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .card-headline-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .flagship-marker-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    background: var(--vol-soft);
    border: 1px solid var(--vol-border-light);
    color: var(--vol-color);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .card-volume-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.25;
  }

  .card-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title-link:hover {
    color: var(--vol-color);
  }

  .card-volume-thesis {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  /* LAYER B: READ THIS IF... */
  .card-read-this-if-box {
    background: var(--vol-soft);
    border-left: 3.5px solid var(--vol-color);
    border-radius: 0 6px 6px 0;
    padding: 10px 14px;
  }

  .read-if-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--vol-color);
    display: block;
    margin-bottom: 2px;
  }

  .read-if-text {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.45;
    margin: 0;
  }

  /* LAYER C: THE JOURNEY (Progressive Arc) */
  .card-journey-box {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
  }

  .journey-box-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .journey-icon {
    color: var(--vol-color);
    font-size: 0.8rem;
  }

  .journey-heading {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .journey-steps-flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .journey-step-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .step-text {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .step-arrow {
    color: var(--vol-color);
    font-size: 0.78rem;
    font-weight: 700;
  }

  /* LAYER D: WHAT'S INSIDE (Chapter Rows with 1-line Summaries) */
  .card-inside-shelf {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 16px;
  }

  .inside-shelf-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .inside-shelf-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .inside-shelf-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--vol-color);
  }

  .inside-shelf-preview-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
  }

  .inside-shelf-hint {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .inside-chapters-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .inside-chapter-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .inside-chapter-row:hover {
    border-color: var(--vol-color);
    transform: translateY(-1px);
  }

  .row-num-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--vol-color);
    background: var(--vol-soft);
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .row-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .row-title-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .row-title {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .row-time-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .row-summary-line {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--text-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .inside-shelf-more-row {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }

  .link-preview-more {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--vol-color);
    cursor: pointer;
    padding: 2px 0;
    text-align: left;
  }

  .link-preview-more:hover {
    text-decoration: underline;
  }

  /* Card Action Footer */
  .card-action-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 24px;
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .footer-left-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn-enter-volume {
    display: inline-flex;
    align-items: center;
    background: var(--vol-color);
    color: #fff !important;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .btn-enter-volume:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .btn-toggle-drawer {
    display: inline-flex;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 6px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .btn-toggle-drawer:hover {
    border-color: var(--vol-color);
    color: var(--text-primary);
  }

  .footer-next-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* Full Chapter Inventory Drawer */
  .volume-full-drawer {
    display: none;
    background: var(--bg-card);
    border-top: 1.5px solid var(--vol-border-light);
    animation: drawerSlide 0.2s ease-out;
  }

  .volume-full-drawer.open {
    display: block;
  }

  @keyframes drawerSlide {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .volume-drawer-inner {
    padding: 20px 24px;
  }

  .drawer-inner-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .drawer-inner-title {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--vol-color);
    display: block;
  }

  .drawer-inner-sub {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .drawer-close-btn {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
  }

  .drawer-close-btn:hover {
    color: var(--text-primary);
  }

  .drawer-topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }

  .drawer-topic-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .drawer-topic-card:hover {
    border-color: var(--vol-color);
    background: var(--bg-card);
    transform: translateY(-1px);
  }

  .drawer-topic-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .drawer-topic-order {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--vol-color);
  }

  .drawer-topic-time {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .drawer-topic-title {
    font-family: var(--font-serif);
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .drawer-topic-summary {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .drawer-topic-creator {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* --------------------------------------------------------------------------
