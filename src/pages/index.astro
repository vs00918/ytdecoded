        </div>
      </div>

      <div class="editorial-volumes-stack">
        {volumeCards.map((vol, idx) => (
          <article 
            class={`editorial-volume-card ${vol.isFlagship ? "card-flagship-featured" : ""}`}
            id={`volume-card-${vol.volumeNumber}`}
            style={`--vol-color: ${vol.visualTheme.accentColor}; --vol-soft: ${vol.visualTheme.accentSoft}; --vol-border-light: ${vol.visualTheme.accentColor}25;`}
            aria-labelledby={`vol-title-${vol.volumeNumber}`}
          >
            <div class="editorial-card-frame">
              
              <!-- LAYER A: WHAT IS THIS? -->
              <div class="card-domain-header">
                <div class="domain-identity-left">
                  <span class="domain-vol-num">VOLUME {vol.romanVol}</span>
                  <span class="domain-bullet">•</span>
                  <span class="domain-title-text">{vol.visualTheme.domainLabel}</span>
                </div>
                <!-- LAYER E: HOW MUCH? -->
                <div class="domain-badge-scale">
                  <span class="scale-load-label">READING LOAD:</span>
                  <div class="reading-load-blocks" title={`${vol.scale.label} reading load (~ ${vol.volMinutes} min)`}>
                    {Array.from({ length: vol.scale.totalBlocks }).map((_, blockIdx) => (
                      <span class={`load-block ${blockIdx < vol.scale.filledBlocks ? "filled" : ""}`}></span>
                    ))}
                  </div>
                  <span class="scale-chapters"><strong>{vol.topics.length}</strong> {vol.topics.length === 1 ? "Chapter" : "Chapters"}</span>
                  <span class="scale-dot">•</span>
                  <span class="scale-time">~{vol.volMinutes} min</span>
                </div>
              </div>

              <!-- Main Card Body Grid -->
              <div class="card-split-body">
                
                <!-- Left Column: Artwork Plate & Scale Box -->
                <div class="card-artwork-column">
                  <div class="artwork-plate-frame">
                    <img 
                      src={vol.visualTheme.illustration} 
                      alt={`${vol.volumeTitle} Thematic Plate`}
                      class="artwork-img"
                      loading="lazy"
                    />
                    <div class="artwork-watermark-vol">{vol.romanVol}</div>
                  </div>

                  <div class="content-load-card">
                    <div class="load-card-header">CONTENT SIZE</div>
                    <div class="load-card-status">{vol.scale.label}</div>
                    <div class="load-card-details">
                      <div><strong>{vol.topics.length}</strong> {vol.topics.length === 1 ? "Chapter" : "Chapters"}</div>
                      <div><strong>~{vol.volMinutes}</strong> Minutes of study</div>
                    </div>
                  </div>
                </div>

                <!-- Right Column: Layers B, C, D -->
                <div class="card-content-column">
                  
                  <div class="card-headline-group">
                    {vol.isFlagship && (
                      <div class="flagship-marker-badge">
                        <span>★ COMPREHENSIVE ANCHOR VOLUME</span>
                      </div>
                    )}
                    <h3 id={`vol-title-${vol.volumeNumber}`} class="card-volume-title">
                      <a href={`/ytdecoded/volumes/${vol.volumeNumber}/`} class="card-title-link">
                        {vol.volumeTitle}
                      </a>
                    </h3>
                    <p class="card-volume-thesis">{vol.thesis}</p>
                  </div>

                  <!-- LAYER B: WHY READ IT? -->
                  <div class="card-read-this-if-box">
                    <span class="read-if-badge">READ THIS IF...</span>
                    <p class="read-if-text">{vol.readThisIf}</p>
                  </div>

                  <!-- LAYER C: THE JOURNEY -->
                  <div class="card-journey-box">
                    <div class="journey-box-header">
                      <span class="journey-icon" aria-hidden="true">➔</span>
                      <span class="journey-heading">THE INTELLECTUAL JOURNEY</span>
                    </div>
                    <div class="journey-steps-flow">
                      {vol.journey.map((step, sIdx) => (
                        <span class="journey-step-item">
                          <span class="step-text">{step}</span>
                          {sIdx < vol.journey.length - 1 && <span class="step-arrow">→</span>}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- LAYER D: WHAT'S INSIDE -->
                  <div class="card-inside-shelf">
                    <div class="inside-shelf-header">
                      <div class="inside-shelf-title-wrap">
                        <span class="inside-shelf-label">WHAT'S INSIDE</span>
                        <span class="inside-shelf-preview-tag">SELECTED PREVIEW ({vol.previewTopics.length} of {vol.topics.length} chapters)</span>
                      </div>
                      <span class="inside-shelf-hint">Exemplary chapters showing the volume's breadth</span>
                    </div>

                    <div class="inside-chapters-list">
                      {vol.previewTopics.map(({ topic: t, readingTime, summary }) => (
                        <a href={`/ytdecoded/topics/${t.slug}/`} class="inside-chapter-row">
                          <div class="row-num-badge">
                            {String(t.data.order_in_volume).padStart(2, "0")}
                          </div>
                          <div class="row-main-content">
                            <div class="row-title-line">
                              <span class="row-title">{t.data.title}</span>
                              <span class="row-time-tag">⏱️ {readingTime} min</span>
                            </div>
                            {summary && (
                              <p class="row-summary-line">{summary}</p>
                            )}
                          </div>
                        </a>
                      ))}
                    </div>

                    {vol.remainingCount > 0 && (
                      <div class="inside-shelf-more-row">
                        <button 
                          type="button" 
                          class="link-preview-more"
                          onclick={`toggleShelfDrawer(${vol.volumeNumber})`}
                          aria-label={`View remaining ${vol.remainingCount} chapters in Volume ${vol.romanVol}`}
                        >
                          + {vol.remainingCount} more {vol.remainingCount === 1 ? "chapter" : "chapters"} in Volume {vol.romanVol} (click to view full inventory) ▾
                        </button>
                      </div>
                    )}
                  </div>

                </div>
              </div>

              <!-- Card Action Footer -->
              <footer class="card-action-footer">
                <div class="footer-left-actions">
                  <a 
                    href={`/ytdecoded/volumes/${vol.volumeNumber}/`} 
                    class="btn-enter-volume"
                    title={`Enter Volume ${vol.romanVol} — ${vol.volumeTitle}`}
                  >
                    Enter Volume {vol.romanVol} ({vol.topics.length} {vol.topics.length === 1 ? "Chapter" : "Chapters"}) →
                  </a>

                  <button 
                    type="button"
                    class="btn-toggle-drawer" 
                    id={`toggle-btn-${vol.volumeNumber}`}
                    data-count={vol.topics.length}
                    aria-expanded="false"
                    aria-controls={`drawer-${vol.volumeNumber}`}
                    onclick={`toggleShelfDrawer(${vol.volumeNumber})`}
                  >
                    <span class="drawer-btn-label">Full Volume Inventory ({vol.topics.length}) ▾</span>
                  </button>
                </div>

                {idx < volumeCards.length - 1 && (
                  <div class="footer-next-hint">
                    <span class="next-hint-text">Next: Vol. {volumeCards[idx + 1].romanVol} — {volumeCards[idx + 1].visualTheme.shortLabel}</span>
                  </div>
                )}
              </footer>

              <!-- Collapsible Full Chapter Inventory Drawer -->
              <div 
                id={`drawer-${vol.volumeNumber}`} 
                class="volume-full-drawer"
                aria-hidden="true"
              >
                <div class="volume-drawer-inner">
                  <div class="drawer-inner-header">
                    <div>
                      <span class="drawer-inner-title">COMPLETE VOLUME INVENTORY — ALL {vol.topics.length} CHAPTERS</span>
                      <div class="drawer-inner-sub">Total study commitment: ~{vol.volMinutes} minutes</div>
                    </div>
                    <button 
                      type="button" 
                      class="drawer-close-btn"
                      onclick={`toggleShelfDrawer(${vol.volumeNumber})`}
                      aria-label="Close chapter inventory"
                    >
                      ✕ Close Inventory
                    </button>
                  </div>

                  <div class="drawer-topics-grid">
                    {vol.processedTopics.map(({ topic: t, readingTime, creator, summary }) => (
                      <a href={`/ytdecoded/topics/${t.slug}/`} class="drawer-topic-card">
                        <div class="drawer-topic-header">
                          <span class="drawer-topic-order">Chapter #{t.data.order_in_volume}</span>
                          <span class="drawer-topic-time">⏱️ {readingTime}m</span>
                        </div>
                        <div class="drawer-topic-title">{t.data.title}</div>
                        {summary && (
                          <div class="drawer-topic-summary">{summary}</div>
                        )}
                        {creator && (
                          <div class="drawer-topic-creator">Mind: <strong>{creator}</strong></div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
    </main>

    <!-- ====================================================================
         SECTION 6: BOTTOM CORPUS STAT STRIP
         ==================================================================== -->
    <section class="bottom-corpus-stat-section" aria-label="Codex Overview Statistics">
      <div class="codex-stat-strip">
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">📖</span>
          <div class="stat-info">
            <span class="stat-num">{totalVolumes}</span>
            <span class="stat-name">Volumes</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">🗂️</span>
          <div class="stat-info">
            <span class="stat-num">{totalTopics}</span>
            <span class="stat-name">Chapters</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon" aria-hidden="true">⏱️</span>
          <div class="stat-info">
            <span class="stat-num">~{totalReadingHours}</span>
            <span class="stat-name">Hours of Study</span>
          </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-unit">
          <span class="stat-icon stat-accent-icon" aria-hidden="true">⚡</span>
          <div class="stat-info">
            <span class="stat-badge-text">100% Offline Semantic Index</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 7: EDITORIAL QUOTE FOOTER
         ==================================================================== -->
    <footer class="codex-quote-banner">
      <div class="quote-content-wrap">
        <span class="quote-symbol" aria-hidden="true">❝</span>
        <span class="quote-text">Knowledge is power only when it is understood, internalized, and applied.</span>
        <span class="quote-author">— The Living Codex</span>
      </div>
    </footer>

  </div>
</ReaderLayout>

<style>
  /* ==========================================================================
     LIVING CODEX: READING DECISION SYSTEM & MASTER READING MAP
     ========================================================================== */

  .library-app-canvas {
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 20px 80px;
  }

  /* --------------------------------------------------------------------------
     HERO BANNER & PRIMARY SEARCH DOOR
     -------------------------------------------------------------------------- */
  .codex-hero-section {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 32px;
    padding: 10px 0 0;
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 4px 14px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .hero-badge-bold {
    font-weight: 700;
    color: var(--accent);
  }

  .hero-badge-dot {
    opacity: 0.4;
  }

  .hero-badge-light {
    font-weight: 500;
  }

  .codex-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .codex-hero-subtitle {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 28px;
  }

  /* Search Door Field */
  .codex-search-door-wrap {
    max-width: 640px;
    margin: 0 auto 24px;
  }

  .codex-search-door-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg-card);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 12px 18px;
    cursor: pointer;
    box-shadow: 0 4px 14px var(--shadow);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
    text-align: left;
  }

  .codex-search-door-btn:hover {
    border-color: var(--accent);
    box-shadow: 0 6px 20px var(--shadow);
    transform: translateY(-1px);
  }

  .search-door-icon {
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .search-door-text-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .search-door-primary {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .search-door-secondary {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .search-door-kbd-group {
    flex-shrink: 0;
  }

  .search-door-kbd {
    display: inline-block;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
