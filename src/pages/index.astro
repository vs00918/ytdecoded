    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .timeline-badge-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .timeline-date-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  .timeline-date-tag.is-fresh {
    color: var(--paper, #fff);
    background: var(--ink, #1f2421);
    border-color: var(--ink, #1f2421);
  }

  .timeline-new-pill {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #fff;
    background: #e63946;
    padding: 2px 5px;
    border-radius: 3px;
  }

  .timeline-vol-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
