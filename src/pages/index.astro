    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .library-badge-sub {
    font-family: var(--font-ui);
    font-size: 0.7rem;
