            <button id="toggle-full-timeline-btn" class="timeline-expand-btn" type="button" onclick="toggleFullTimeline()">
              <span id="timeline-btn-text">View Full Chronological Archive ({recentTopics.length} Notes) ▾</span>
            </button>
          </div>
        )}

        <!-- Extended Drawer for remaining chronological topics -->
        <div id="extended-timeline-drawer" class="extended-timeline-drawer" style="display: none;">
          <div class="timeline-cards-grid extended-grid">
            {recentTopics.slice(6).map((topic) => {
              const readingTime = topic.data.reading_time_minutes || Math.max(1, Math.ceil((topic.body?.split(/\s+/).filter(Boolean).length || 0) / 225));
              const creator = topic.data.sources && topic.data.sources.length > 0 ? topic.data.sources[0].creator : null;
              return (
