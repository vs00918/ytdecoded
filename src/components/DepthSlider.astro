---
// DepthSlider.astro — 3-Tier progressive disclosure reading control
const { label = 'Cognitive Reading Mode', compact = false } = Astro.props;
---

<div class={`depth-slider-card ${compact ? 'depth-slider-compact' : ''}`}>
  <div class="depth-header-strip">
    <div class="depth-label">
      <span class="depth-kicker">EDITORIAL READING DEPTH</span>
    </div>
    <div class="depth-mode-hint">
      Full Deep-Dive: Complete prose, detailed explanations & study notes
    </div>
  </div>
  <div class="depth-buttons" role="group" aria-label="Reading Depth Toggle">
    <button class="depth-btn" data-depth="axiom" title="Show 15-second core axiom + visual mindmaps and flowcharts">
      15-SEC AXIOM
    </button>
    <button class="depth-btn" data-depth="model" title="Show conceptual ladders, structured bullet points & key steps">
      5-MIN MODEL
    </button>
    <button class="depth-btn active" data-depth="deep" title="Show full uninterrupted text, explanations & study notes (mindmaps hidden to save page space)">
      FULL DEEP-DIVE
    </button>
  </div>
</div>

<style>
  .depth-slider-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--wash);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    border-left: none;
    border-right: none;
    border-radius: 0;
    padding: 12px 0;
    margin: 20px 0 28px 0;
    box-shadow: none;
  }

  .depth-slider-card.depth-slider-compact {
    padding: 8px 0;
    margin: 14px 0 20px 0;
    gap: 8px;
  }

  .depth-header-strip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .depth-label {
    display: flex;
    align-items: center;
  }

  .depth-kicker {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .depth-mode-hint {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--muted);
  }

  .depth-buttons {
    display: flex;
    gap: 6px;
    background: transparent;
    padding: 0;
    border-radius: 0;
    border: none;
    flex-wrap: wrap;
  }

  .depth-btn {
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.15s ease;
    flex: 1 1 auto;
    text-align: center;
  }

  .depth-slider-compact .depth-btn {
    padding: 4px 10px;
    font-size: 10px;
  }

  .depth-btn:hover {
    background: var(--wash);
    border-color: var(--ink);
  }

  .depth-btn.active {
    background: var(--ink);
    color: var(--paper) !important;
    border-color: var(--ink);
    box-shadow: none;
  }
</style>

<script is:inline>
  const MODE_HINTS = {
    axiom: '⚡ 15-Sec Axiom: Visual mindmaps, flowcharts & core axiomatic kernel',
    model: '📊 5-Min Model: Conceptual ladders, structured bullet points & step models',
    deep: '📖 Full Deep-Dive: Complete prose & study notes (diagrams hidden to save page space)'
  };

  window.applyReadingDepth = function(mode) {
    document.documentElement.setAttribute('data-reading-depth', mode);
    localStorage.setItem('living_codex_depth', mode);
    
    // Update active button state on all sliders across the page
    document.querySelectorAll('.depth-btn').forEach(btn => {
      if (btn.getAttribute('data-depth') === mode) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // Update dynamic hint text on all sliders
    document.querySelectorAll('.depth-mode-hint').forEach(hintEl => {
      if (MODE_HINTS[mode]) {
        hintEl.textContent = MODE_HINTS[mode];
      }
    });

    // Update ALL chapter prose containers on the page (supports continuous volume reader with N chapters)
    const proseList = document.querySelectorAll('.reader-prose');
    proseList.forEach(prose => {
      prose.classList.remove('depth-filter-axiom', 'depth-filter-model', 'depth-filter-deep');
      prose.classList.add('depth-filter-' + mode);
    });

    // If switching into axiom mode, ensure Mermaid diagrams are properly rendered
    if (mode === 'axiom' && typeof window.renderMermaidDiagrams === 'function') {
      setTimeout(() => {
        window.renderMermaidDiagrams();
      }, 30);
    }

    window.dispatchEvent(new CustomEvent('depth-changed', { detail: { mode } }));
  };

  function setupDepthControls() {
    document.querySelectorAll('.depth-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-depth');
        window.applyReadingDepth(mode);
      });
    });

    // Restore saved depth mode or default to deep
    const savedDepth = localStorage.getItem('living_codex_depth') || 'deep';
    window.applyReadingDepth(savedDepth);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDepthControls);
  } else {
    setupDepthControls();
  }
</script>
