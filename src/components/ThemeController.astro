---
// ThemeController.astro - Handles Sepia, Paper, Dark, OLED themes + Font Sizing with LocalStorage persistence
---

<div class="reading-controls">
  <!-- Font Size Scaler (A- / A+) -->
  <div class="font-size-controller" title="Adjust text size">
    <button class="font-size-btn" onclick="adjustFontSize(-1)" aria-label="Decrease text size" title="Smaller text (A-)">A-</button>
    <button class="font-size-btn" onclick="adjustFontSize(1)" aria-label="Increase text size" title="Larger text (A+)">A+</button>
  </div>

  <!-- Page Width Toggle (Standard / Wide / Full) -->
  <div class="width-controller" title="Adjust reading column width">
    <button id="width-narrow-btn" class="width-btn" onclick="setReadingWidth('narrow')" title="Standard Focus Width (740px)" aria-label="Standard Width">740</button>
    <button id="width-medium-btn" class="width-btn" onclick="setReadingWidth('medium')" title="Comfortable Wide (960px)" aria-label="Medium Width">960</button>
    <button id="width-full-btn" class="width-btn" onclick="setReadingWidth('full')" title="Spacious Cinema Width (1200px)" aria-label="Full Width">1200</button>
  </div>

  <!-- Focus Audio & Zen Mode Controls -->
  <div class="sanctuary-controls">
    <button id="ambient-audio-btn" class="sanctuary-icon-btn" onclick="toggleAmbientAudio()" title="Focus Rain Audio (WebAudio)" aria-label="Toggle Focus Audio">
      <span class="btn-icon">🌧️</span>
    </button>
    <button id="zen-mode-btn" class="sanctuary-icon-btn" onclick="toggleZenMode()" title="Zen Focus Mode (Hide UI distractions)" aria-label="Toggle Zen Mode">
      <span class="btn-icon">🧘</span>
    </button>
  </div>

  <!-- Color Palette Swatches -->
  <div class="theme-controller" title="Select color theme">
    <button class="theme-btn swatch-sepia" onclick="setTheme('sepia')" title="Sepia Warm" aria-label="Sepia Theme"></button>
    <button class="theme-btn swatch-paper" onclick="setTheme('paper')" title="Paper White" aria-label="Paper Theme"></button>
    <button class="theme-btn swatch-dark" onclick="setTheme('dark')" title="Charcoal Night" aria-label="Dark Theme"></button>
    <button class="theme-btn swatch-oled" onclick="setTheme('oled')" title="Pitch Black OLED" aria-label="OLED Theme"></button>
  </div>
</div>

<style>
  .reading-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .font-size-controller {
    display: flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2px 4px;
    gap: 2px;
  }

  .font-size-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .font-size-btn:hover, .font-size-btn:focus-visible {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .width-controller {
    display: flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2px 4px;
    gap: 2px;
  }

  .width-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .width-btn:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .width-btn.active {
    background: var(--accent);
    color: #ffffff !important;
  }

  .theme-controller {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 4px 8px;
    border-radius: 20px;
  }

  .theme-btn {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .theme-btn:hover {
    transform: scale(1.15);
  }

  .swatch-sepia { background-color: #fbf0d9; border-color: #d8c29d; }
  .swatch-paper { background-color: #ffffff; border-color: #d1d5db; }
  .swatch-dark  { background-color: #27272a; border-color: #52525b; }
  .swatch-oled  { background-color: #000000; border-color: #3f3f46; }

  .sanctuary-controls {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .sanctuary-icon-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 3px 7px;
    cursor: pointer;
    font-size: 0.82rem;
    transition: all 0.15s ease;
  }

  .sanctuary-icon-btn:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .sanctuary-icon-btn.active {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>

<script is:inline>
  // Expose functions globally on window for inline handlers & programmatic control
  window.setTheme = function(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('codex-theme', theme);
    window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme } }));
  };

  window.toggleZenMode = function() {
    document.body.classList.toggle('zen-mode');
    const btn = document.getElementById('zen-mode-btn');
    if (btn) btn.classList.toggle('active');
  };

  let audioCtx = null;
  let rainGain = null;
  let isPlayingRain = false;

  window.toggleAmbientAudio = function() {
    const btn = document.getElementById('ambient-audio-btn');
    if (!isPlayingRain) {
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          const bufferSize = audioCtx.sampleRate * 2;
          const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = Math.random() * 2 - 1;
          }
          const noise = audioCtx.createBufferSource();
          noise.buffer = buffer;
          noise.loop = true;

          const filter = audioCtx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.value = 650;

          rainGain = audioCtx.createGain();
          rainGain.gain.value = 0.08;

          noise.connect(filter);
          filter.connect(rainGain);
          rainGain.connect(audioCtx.destination);
          noise.start();
        } else {
          audioCtx.resume();
        }
        isPlayingRain = true;
        if (btn) btn.classList.add('active');
      } catch (e) {
        console.warn('Ambient audio could not start:', e);
      }
    } else {
      if (audioCtx) audioCtx.suspend();
      isPlayingRain = false;
      if (btn) btn.classList.remove('active');
    }
  };

  const fontSizes = ['17.5px', '19.5px', '21.5px', '23px'];
  let currentFontIdx = 1; // default 19.5px

  window.adjustFontSize = function(delta) {
    currentFontIdx = Math.max(0, Math.min(fontSizes.length - 1, currentFontIdx + delta));
    const size = fontSizes[currentFontIdx];
    document.documentElement.style.setProperty('--font-base-size', size);
    localStorage.setItem('codex-font-size-idx', currentFontIdx);
  };

  window.setReadingWidth = function(widthKey) {
    const widthMap = {
      narrow: '740px',
      medium: '960px',
      full: '1200px'
    };
    const chosenWidth = widthMap[widthKey] || '740px';
    document.documentElement.style.setProperty('--content-max-width', chosenWidth);
    document.querySelectorAll('.reader-container:not(.wide-layout):not(.volume-layout)').forEach(el => {
      el.style.maxWidth = chosenWidth;
    });
    localStorage.setItem('codex-reading-width', widthKey);

    document.querySelectorAll('.width-btn').forEach(btn => btn.classList.remove('active'));
    const activeBtn = document.getElementById(`width-${widthKey}-btn`);
    if (activeBtn) activeBtn.classList.add('active');
  };

  // Wire event listeners directly on DOM elements as guaranteed fallback
  function setupReadingControls() {
    const narrowBtn = document.getElementById('width-narrow-btn');
    const mediumBtn = document.getElementById('width-medium-btn');
    const fullBtn = document.getElementById('width-full-btn');
    if (narrowBtn) narrowBtn.addEventListener('click', () => window.setReadingWidth('narrow'));
    if (mediumBtn) mediumBtn.addEventListener('click', () => window.setReadingWidth('medium'));
    if (fullBtn) fullBtn.addEventListener('click', () => window.setReadingWidth('full'));

    const zenBtn = document.getElementById('zen-mode-btn');
    if (zenBtn) zenBtn.addEventListener('click', () => window.toggleZenMode());

    const audioBtn = document.getElementById('ambient-audio-btn');
    if (audioBtn) audioBtn.addEventListener('click', () => window.toggleAmbientAudio());

    // Font size buttons
    document.querySelectorAll('.font-size-btn').forEach((btn, idx) => {
      btn.addEventListener('click', () => window.adjustFontSize(idx === 0 ? -1 : 1));
    });

    // Theme swatches
    const themeMap = {
      'swatch-sepia': 'sepia',
      'swatch-paper': 'paper',
      'swatch-dark': 'dark',
      'swatch-oled': 'oled'
    };
    for (const [cls, thm] of Object.entries(themeMap)) {
      const btn = document.querySelector(`.${cls}`);
      if (btn) btn.addEventListener('click', () => window.setTheme(thm));
    }

    // Restore saved width indicator
    const savedWidth = localStorage.getItem('codex-reading-width') || 'narrow';
    window.setReadingWidth(savedWidth);
  }

  // Initialize theme, font size, and reading width immediately
  (function() {
    const savedTheme = localStorage.getItem('codex-theme') || 'sepia';
    document.documentElement.setAttribute('data-theme', savedTheme);

    const savedFontIdx = localStorage.getItem('codex-font-size-idx');
    if (savedFontIdx !== null && fontSizes[savedFontIdx]) {
      currentFontIdx = parseInt(savedFontIdx, 10);
      document.documentElement.style.setProperty('--font-base-size', fontSizes[currentFontIdx]);
    }

    const savedWidth = localStorage.getItem('codex-reading-width') || 'narrow';
    window.setReadingWidth(savedWidth);
  })();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupReadingControls);
  } else {
    setupReadingControls();
  }
</script>
