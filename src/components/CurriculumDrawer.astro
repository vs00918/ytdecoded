---
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentSlug?: string;
  currentVolume?: number;
  allVolumes: {
    volume: number;
    volumeTitle: string;
    topics: CollectionEntry<'topics'>[];
  }[];
}

const { currentSlug = '', currentVolume, allVolumes } = Astro.props;
const totalTopics = allVolumes.reduce((acc, v) => acc + v.topics.length, 0);
---

<aside id="curriculum-drawer" class="curriculum-drawer" aria-label="Curriculum Navigation" aria-hidden="true">
  <div class="drawer-header">
    <div class="drawer-title-wrap">
      <span class="drawer-title">📖 The Living Codex</span>
      <span class="drawer-subtitle">{allVolumes.length} Volumes • {totalTopics} Chapters</span>
    </div>
    <button id="drawer-close-btn" class="drawer-close-btn" aria-label="Close Curriculum Drawer">✕</button>
  </div>

  <div class="drawer-content">
    {allVolumes.map((volGroup) => {
      const isCurrentVol = currentVolume ? volGroup.volume === currentVolume : volGroup.topics.some((t) => t.slug === currentSlug);
      return (
        <details class="volume-accordion" open={isCurrentVol || allVolumes.length <= 2}>
          <summary class="volume-summary">
            <span class="volume-caret">▾</span>
            <span class="volume-num-badge">Vol {volGroup.volume}</span>
            <span class="volume-name" title={volGroup.volumeTitle}>{volGroup.volumeTitle}</span>
            <span class="volume-count-tag">{volGroup.topics.length}</span>
          </summary>

          <ul class="topic-sublist">
            {volGroup.topics.map((topic) => {
              const isActive = topic.slug === currentSlug;
              // If we are currently on the volume continuous reader for this volume, link to in-page #chapter-N
              const targetHref = (currentVolume && currentVolume === volGroup.volume)
                ? `#chapter-${topic.data.order_in_volume}`
                : `/ytdecoded/topics/${topic.slug}/`;

              return (
                <li class={`topic-nav-item ${isActive ? 'active' : ''}`}>
                  <a 
                    href={targetHref} 
                    class="topic-nav-link" 
                    data-inpage-chapter={currentVolume && currentVolume === volGroup.volume ? String(topic.data.order_in_volume) : undefined}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    <span class="topic-order">#{topic.data.order_in_volume}</span>
                    <span class="topic-label">{topic.data.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
  </div>
</aside>

<div id="drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>

<style>
  .curriculum-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 360px;
    max-width: 85vw;
    height: 100vh;
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border);
    z-index: 200;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px var(--shadow);
    font-family: var(--font-ui);
  }

  .curriculum-drawer.open {
    transform: translateX(0);
  }

  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.35);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-header {
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
  }

  .drawer-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .drawer-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .drawer-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .drawer-close-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    width: 28px;
    height: 28px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .drawer-close-btn:hover, .drawer-close-btn:focus-visible {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
    outline: none;
  }

  .drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 12px 10px;
  }

  .volume-accordion {
    margin-bottom: 8px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
  }

  .volume-accordion[open] {
    border-color: var(--border);
    background: var(--bg-surface);
  }

  .volume-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    cursor: pointer;
    user-select: none;
    font-weight: 600;
    font-size: 0.84rem;
    color: var(--text-primary);
    list-style: none;
    transition: background 0.15s ease;
  }

  .volume-summary::-webkit-details-marker {
    display: none;
  }

  .volume-summary:hover {
    background: var(--accent-soft);
  }

  .volume-caret {
    font-size: 0.75rem;
    color: var(--text-muted);
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .volume-accordion[open] .volume-caret {
    transform: rotate(0deg);
  }

  .volume-accordion:not([open]) .volume-caret {
    transform: rotate(-90deg);
  }

  .volume-num-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--border);
    color: var(--text-primary);
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .volume-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-serif);
    font-size: 0.88rem;
  }

  .volume-count-tag {
    font-size: 0.68rem;
    color: var(--text-muted);
    background: var(--bg-sidebar);
    padding: 1px 5px;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }

  .topic-sublist {
    list-style: none;
    padding: 4px 6px 6px 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .topic-nav-item {
    margin: 2px 0;
  }

  .topic-nav-link {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 5px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.3;
    transition: all 0.12s ease;
  }

  .topic-nav-link:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .topic-nav-item.active .topic-nav-link {
    background: var(--accent);
    color: #ffffff !important;
    font-weight: 600;
  }

  .topic-order {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    opacity: 0.8;
    flex-shrink: 0;
  }

  .topic-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script is:inline>
  function setupDrawer() {
    const drawer = document.getElementById('curriculum-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const closeBtn = document.getElementById('drawer-close-btn');
    const toggleBtn = document.getElementById('drawer-toggle-btn');

    function openDrawer() {
      if (drawer && backdrop) {
        drawer.classList.add('open');
        backdrop.classList.add('open');
        drawer.setAttribute('aria-hidden', 'false');
        backdrop.setAttribute('aria-hidden', 'false');
      }
    }

    function closeDrawer() {
      if (drawer && backdrop) {
        drawer.classList.remove('open');
        backdrop.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        backdrop.setAttribute('aria-hidden', 'true');
      }
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    // In-page smooth scroll & drawer closing when clicking chapters in current volume
    document.querySelectorAll('.topic-nav-link[data-inpage-chapter]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const chapterNum = link.getAttribute('data-inpage-chapter');
        const targetEl = document.getElementById(`chapter-${chapterNum}`);
        if (targetEl) {
          e.preventDefault();
          closeDrawer();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', `#chapter-${chapterNum}`);
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === '\\' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        if (drawer && drawer.classList.contains('open')) {
          closeDrawer();
        } else {
          openDrawer();
        }
      }
      if (e.key === 'Escape' && drawer && drawer.classList.contains('open')) {
        closeDrawer();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupDrawer);
</script>
