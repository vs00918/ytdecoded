---
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentSlug?: string;
  allVolumes: {
    volume: number;
    volumeTitle: string;
    topics: CollectionEntry<'topics'>[];
  }[];
}

const { currentSlug = '', allVolumes } = Astro.props;
const totalTopics = allVolumes.reduce((acc, v) => acc + v.topics.length, 0);
---

<aside id="curriculum-drawer" class="curriculum-drawer" aria-label="Curriculum Navigation" aria-hidden="true">
  <div class="drawer-header">
    <div class="drawer-title-wrap">
      <span class="drawer-title">📖 The Living Codex</span>
      <span class="drawer-subtitle">{allVolumes.length}-Volume Knowledge Ladder • {totalTopics} Chapters</span>
    </div>
    <button id="drawer-close-btn" class="drawer-close-btn" aria-label="Close Curriculum Drawer">✕</button>
  </div>

  <div class="drawer-content">
    {allVolumes.map((volGroup) => {
      const isCurrentVol = volGroup.topics.some((t) => t.slug === currentSlug);
      return (
        <details class="volume-accordion" open={isCurrentVol || allVolumes.length <= 3}>
          <summary class="volume-summary">
            <span class="volume-num-badge">Vol {volGroup.volume}</span>
            <span class="volume-name">{volGroup.volumeTitle}</span>
          </summary>

          <ul class="topic-sublist">
            {volGroup.topics.map((topic) => {
              const isActive = topic.slug === currentSlug;
              return (
                <li class={`topic-nav-item ${isActive ? 'active' : ''}`}>
                  <a href={`/ytdecoded/topics/${topic.slug}/`} class="topic-nav-link" aria-current={isActive ? 'page' : undefined}>
                    <span class="topic-order">#{topic.data.order_in_volume}</span>
                    <span class="topic-label">{topic.data.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
  </div>
</aside>

<div id="drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>

<style>
  .curriculum-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 360px;
    max-width: 85vw;
    height: 100vh;
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border);
    z-index: 200;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px var(--shadow);
    font-family: var(--font-ui);
  }

  .curriculum-drawer.open {
    transform: translateX(0);
  }

  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.35);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-header {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
  }

  .drawer-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .drawer-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .drawer-subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .drawer-close-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    width: 28px;
    height: 28px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .drawer-close-btn:hover, .drawer-close-btn:focus-visible {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
    outline: none;
  }

  .drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 14px 12px;
  }

  .volume-accordion {
    margin-bottom: 8px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid transparent;
  }

  .volume-accordion[open] {
    border-color: var(--border-subtle);
    background: var(--bg-surface);
  }

  .volume-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    cursor: pointer;
    user-select: none;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary);
    list-style: none;
    transition: background 0.15s ease;
    border-radius: 6px;
  }

  .volume-summary::-webkit-details-marker {
    display: none;
  }

  .volume-summary:hover {
    background: var(--accent-soft);
  }

  .volume-num-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--border);
    color: var(--text-primary);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .volume-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topic-sublist {
    list-style: none;
    padding: 4px 8px 8px 24px;
  }

  .topic-nav-item {
    margin: 3px 0;
  }

  .topic-nav-link {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 6px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.35;
    transition: all 0.12s ease;
  }

  .topic-nav-link:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .topic-nav-item.active .topic-nav-link {
    background: var(--accent);
    color: var(--bg-page);
    font-weight: 600;
  }

  .topic-order {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.7;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .topic-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>

<script is:inline>
  function setupDrawer() {
    const drawer = document.getElementById('curriculum-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const closeBtn = document.getElementById('drawer-close-btn');
    const toggleBtn = document.getElementById('drawer-toggle-btn');

    function openDrawer() {
      if (drawer && backdrop) {
        drawer.classList.add('open');
        backdrop.classList.add('open');
        drawer.setAttribute('aria-hidden', 'false');
        backdrop.setAttribute('aria-hidden', 'false');
      }
    }

    function closeDrawer() {
      if (drawer && backdrop) {
        drawer.classList.remove('open');
        backdrop.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        backdrop.setAttribute('aria-hidden', 'true');
      }
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    window.addEventListener('keydown', (e) => {
      if (e.key === '\\' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        if (drawer && drawer.classList.contains('open')) {
          closeDrawer();
        } else {
          openDrawer();
        }
      }
      if (e.key === 'Escape' && drawer && drawer.classList.contains('open')) {
        closeDrawer();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupDrawer);
</script>
