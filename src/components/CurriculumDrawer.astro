---
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentSlug?: string;
  currentVolume?: number;
  allVolumes: {
    volume: number;
    volumeTitle: string;
    topics: CollectionEntry<'topics'>[];
  }[];
}

const { currentSlug = '', currentVolume, allVolumes } = Astro.props;
const totalTopics = allVolumes.reduce((acc, v) => acc + v.topics.length, 0);

// Flatten and sort chronologically (newest first)
const allTopicsFlattened = allVolumes.flatMap((v) => v.topics);
const chronologicalTopics = [...allTopicsFlattened].sort((a, b) => {
  const dateA = a.data.last_updated || '2026-09-01';
  const dateB = b.data.last_updated || '2026-09-01';
  if (dateB !== dateA) return dateB.localeCompare(dateA);
  if (b.data.volume !== a.data.volume) return b.data.volume - a.data.volume;
  return (b.data.order_in_volume || 0) - (a.data.order_in_volume || 0);
});

function formatDrawerDate(dateStr?: string): string {
  if (!dateStr) return 'Sep 2026';
  const parts = dateStr.split('-');
  if (parts.length === 3) {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const mIdx = parseInt(parts[1], 10) - 1;
    const day = parseInt(parts[2], 10);
    return `${day} ${months[mIdx] || 'Sep'}`;
  }
  return dateStr;
}
---

<aside id="curriculum-drawer" class="curriculum-drawer" aria-label="Curriculum Navigation" aria-hidden="true">
  <div class="drawer-header">
    <div class="drawer-title-wrap">
      <span class="drawer-title">📖 The Living Codex</span>
      <span class="drawer-subtitle">{allVolumes.length} Volumes • {totalTopics} Chapters</span>
    </div>
    <button id="drawer-close-btn" class="drawer-close-btn" aria-label="Close Curriculum Drawer">✕</button>
  </div>

  <div class="drawer-nav-tabs" role="tablist">
    <button id="drawer-tab-volumes" class="drawer-nav-tab active" role="tab" aria-selected="true" aria-controls="drawer-panel-volumes">
      By Volume ({allVolumes.length})
    </button>
    <button id="drawer-tab-timeline" class="drawer-nav-tab" role="tab" aria-selected="false" aria-controls="drawer-panel-timeline">
      ⏱️ Timeline ({chronologicalTopics.length})
    </button>
  </div>

  <div class="drawer-content">
    <!-- Panel 1: Structured Hierarchical Volume Accordions -->
    <div id="drawer-panel-volumes" class="drawer-tab-panel active" role="tabpanel">
      {allVolumes.map((volGroup) => {
        const isCurrentVol = currentVolume ? volGroup.volume === currentVolume : volGroup.topics.some((t) => t.slug === currentSlug);
        return (
          <details class="volume-accordion" open={isCurrentVol || allVolumes.length <= 2}>
            <summary class="volume-summary">
              <span class="volume-caret">▾</span>
              <span class="volume-num-badge">Vol {volGroup.volume}</span>
              <span class="volume-name" title={volGroup.volumeTitle}>{volGroup.volumeTitle}</span>
              <span class="volume-count-tag">{volGroup.topics.length}</span>
            </summary>

            <ul class="topic-sublist">
              {volGroup.topics.map((topic, idx) => {
                const chapterSeq = idx + 1;
                const isActive = topic.slug === currentSlug;
                // If we are currently on the volume continuous reader for this volume, link to in-page #chapter-N
                const targetHref = (currentVolume && currentVolume === volGroup.volume)
                  ? `#chapter-${chapterSeq}`
                  : `/ytdecoded/topics/${topic.slug}/`;

                return (
                  <li class={`topic-nav-item ${isActive ? 'active' : ''}`}>
                    <a 
                      href={targetHref} 
                      class="topic-nav-link" 
                      data-inpage-chapter={currentVolume && currentVolume === volGroup.volume ? String(chapterSeq) : undefined}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      <span class="topic-order">#{chapterSeq}</span>
                      <span class="topic-label">{topic.data.title}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        );
      })}
    </div>

    <!-- Panel 2: Chronological Timeline Feed (Newest First) -->
    <div id="drawer-panel-timeline" class="drawer-tab-panel" role="tabpanel" style="display: none;">
      <div class="drawer-timeline-note">Showing all {chronologicalTopics.length} chapters ordered by newest addition:</div>
      <ul class="drawer-timeline-list">
        {chronologicalTopics.map((topic) => {
          const isActive = topic.slug === currentSlug;
          const readingTime = topic.data.reading_time_minutes || Math.max(1, Math.ceil((topic.body?.split(/\s+/).filter(Boolean).length || 0) / 225));
          return (
            <li class={`drawer-timeline-item ${isActive ? 'active' : ''}`}>
              <a href={`/ytdecoded/topics/${topic.slug}/`} class="drawer-timeline-link" aria-current={isActive ? 'page' : undefined}>
                <div class="drawer-timeline-meta">
                  <span class="drawer-timeline-date">{formatDrawerDate(topic.data.last_updated)}</span>
                  <span class="drawer-timeline-vol">Vol {topic.data.volume}</span>
                  <span class="drawer-timeline-time">⏱️ {readingTime}m</span>
                </div>
                <span class="drawer-timeline-title">{topic.data.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</aside>

<div id="drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>

<style>
  .curriculum-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 360px;
    max-width: 85vw;
    height: 100vh;
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border);
    z-index: 200;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px var(--shadow);
    font-family: var(--font-ui);
  }

  .curriculum-drawer.open {
    transform: translateX(0);
  }

  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.35);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-header {
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
  }

  .drawer-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .drawer-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .drawer-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .drawer-close-btn {
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink);
    width: 26px;
    height: 26px;
    border-radius: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .drawer-close-btn:hover, .drawer-close-btn:focus-visible {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
    outline: none;
  }

  .drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 12px 10px;
  }

  .volume-accordion {
    margin-bottom: 8px;
    border-radius: 0;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--wash);
  }

  .volume-accordion[open] {
    border-color: var(--ink);
    background: var(--paper);
  }

  .volume-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    cursor: pointer;
    user-select: none;
    font-weight: 700;
    font-size: 0.82rem;
    font-family: var(--font-ui);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    list-style: none;
    transition: background 0.15s ease;
  }

  .volume-summary::-webkit-details-marker {
    display: none;
  }

  .volume-summary:hover {
    background: var(--wash);
  }

  .volume-caret {
    font-size: 0.75rem;
    color: var(--muted);
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .volume-accordion[open] .volume-caret {
    transform: rotate(0deg);
  }

  .volume-accordion:not([open]) .volume-caret {
    transform: rotate(-90deg);
  }

  .volume-num-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    padding: 1px 5px;
    border-radius: 0;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  .volume-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-serif);
    font-size: 0.88rem;
  }

  .volume-count-tag {
    font-size: 0.68rem;
    color: var(--text-muted);
    background: var(--bg-sidebar);
    padding: 1px 5px;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }

  .topic-sublist {
    list-style: none;
    padding: 4px 6px 6px 14px;
    border-top: 1px solid var(--rule);
  }

  .topic-nav-item {
    margin: 2px 0;
  }

  .topic-nav-link {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 0;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.82rem;
    font-family: var(--font-serif);
    line-height: 1.3;
    transition: all 0.12s ease;
  }

  .topic-nav-link:hover {
    background: var(--wash);
    color: var(--ink);
  }

  .topic-nav-item.active .topic-nav-link {
    background: var(--ink);
    color: var(--paper) !important;
    font-weight: 700;
  }

  .topic-order {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    opacity: 0.8;
    flex-shrink: 0;
  }

  .topic-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* --- DUAL TABS STYLING --- */
  .drawer-nav-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    background: var(--bg-sidebar);
    padding: 6px 10px 0;
    gap: 6px;
    flex-shrink: 0;
  }

  .drawer-nav-tab {
    flex: 1;
    padding: 8px 6px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
    font-family: var(--font-ui);
  }

  .drawer-nav-tab:hover {
    color: var(--ink);
  }

  .drawer-nav-tab.active {
    color: var(--ink);
    border-bottom-color: var(--ink);
    background: var(--wash);
  }

  .drawer-timeline-note {
    font-size: 0.72rem;
    color: var(--muted);
    padding: 4px 6px 10px;
    font-family: var(--font-ui);
    letter-spacing: 0.02em;
  }

  .drawer-timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .drawer-timeline-item {
    border: 1px solid var(--rule);
    background: var(--paper);
    transition: all 0.15s ease;
  }

  .drawer-timeline-item:hover {
    border-color: var(--ink);
    transform: translateX(2px);
  }

  .drawer-timeline-item.active {
    border-color: var(--ink);
    background: var(--wash);
  }

  .drawer-timeline-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
    text-decoration: none;
    color: inherit;
  }

  .drawer-timeline-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    font-family: var(--font-mono);
  }

  .drawer-timeline-date {
    font-weight: 700;
    color: var(--paper);
    background: var(--ink);
    padding: 1px 5px;
    border-radius: 2px;
  }

  .drawer-timeline-vol {
    font-weight: 600;
    color: var(--muted);
    background: var(--wash);
    border: 1px solid var(--rule);
    padding: 1px 5px;
  }

  .drawer-timeline-time {
    margin-left: auto;
    color: var(--muted);
  }

  .drawer-timeline-title {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    line-height: 1.3;
    color: var(--ink);
    font-weight: 600;
  }
</style>

<script is:inline>
  function setupDrawer() {
    const drawer = document.getElementById('curriculum-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const closeBtn = document.getElementById('drawer-close-btn');
    const toggleBtn = document.getElementById('drawer-toggle-btn');

    // Tab switching logic
    const tabVolumes = document.getElementById('drawer-tab-volumes');
    const tabTimeline = document.getElementById('drawer-tab-timeline');
    const panelVolumes = document.getElementById('drawer-panel-volumes');
    const panelTimeline = document.getElementById('drawer-panel-timeline');

    function showTab(tabName) {
      if (tabName === 'timeline') {
        tabVolumes?.classList.remove('active');
        tabVolumes?.setAttribute('aria-selected', 'false');
        tabTimeline?.classList.add('active');
        tabTimeline?.setAttribute('aria-selected', 'true');
        if (panelVolumes) panelVolumes.style.display = 'none';
        if (panelTimeline) panelTimeline.style.display = 'block';
        sessionStorage.setItem('drawer_active_tab', 'timeline');
      } else {
        tabTimeline?.classList.remove('active');
        tabTimeline?.setAttribute('aria-selected', 'false');
        tabVolumes?.classList.add('active');
        tabVolumes?.setAttribute('aria-selected', 'true');
        if (panelTimeline) panelTimeline.style.display = 'none';
        if (panelVolumes) panelVolumes.style.display = 'block';
        sessionStorage.setItem('drawer_active_tab', 'volumes');
      }
    }

    if (tabVolumes) tabVolumes.addEventListener('click', () => showTab('volumes'));
    if (tabTimeline) tabTimeline.addEventListener('click', () => showTab('timeline'));

    // Restore tab preference
    const savedTab = sessionStorage.getItem('drawer_active_tab');
    if (savedTab === 'timeline') {
      showTab('timeline');
    }

    function openDrawer() {
      if (drawer && backdrop) {
        drawer.classList.add('open');
        backdrop.classList.add('open');
        drawer.setAttribute('aria-hidden', 'false');
        backdrop.setAttribute('aria-hidden', 'false');
      }
    }

    function closeDrawer() {
      if (drawer && backdrop) {
        drawer.classList.remove('open');
        backdrop.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        backdrop.setAttribute('aria-hidden', 'true');
      }
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    // In-page smooth scroll & drawer closing when clicking chapters in current volume
    document.querySelectorAll('.topic-nav-link[data-inpage-chapter]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const chapterNum = link.getAttribute('data-inpage-chapter');
        const targetEl = document.getElementById(`chapter-${chapterNum}`);
        if (targetEl) {
          e.preventDefault();
          closeDrawer();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', `#chapter-${chapterNum}`);
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === '\\' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        if (drawer && drawer.classList.contains('open')) {
          closeDrawer();
        } else {
          openDrawer();
        }
      }
      if (e.key === 'Escape' && drawer && drawer.classList.contains('open')) {
        closeDrawer();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupDrawer);
</script>
