---
interface Props {
  sources: Array<{
    source_id: string;
    title: string;
    creator: string;
    url: string;
    evidence_type?: string;
    key_contributions?: Array<{
      claim: string;
      timestamp?: string;
    }>;
  }>;
}

const { sources } = Astro.props;
---

{sources && sources.length > 0 && (
  <section class="provenance-section">
    <div class="provenance-header">
      <span>📚</span>
      <span>Source Provenance & Empirical Citations</span>
    </div>
    
    <div class="sources-list">
      {sources.map((src) => (
        <div class="source-card">
          <div class="source-title">
            <a href={src.url} target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: underline;">
              {src.title}
            </a>
          </div>
          <div class="source-meta">
            <span>By <strong>{src.creator}</strong></span>
            {src.evidence_type && (
              <>
                <span> • </span>
                <span style="text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.05em;">{src.evidence_type.replace(/_/g, ' ')}</span>
              </>
            )}
          </div>
          
          {src.key_contributions && src.key_contributions.length > 0 && (
            <ul class="source-contributions">
              {src.key_contributions.map((c) => (
                <li>
                  <span>{c.claim}</span>
                  {c.timestamp && (
                    <a href={`${src.url}&t=${c.timestamp.replace(':', 'm')}s`} target="_blank" rel="noopener noreferrer" class="timestamp-chip">
                      ⏱️ {c.timestamp}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>
)}
