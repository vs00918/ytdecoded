---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length >= 2 && (
  <nav aria-label="Table of Contents" class="toc-container">
    <details class="toc-details" id="toc-details" open>
      <summary class="toc-summary">
        <span class="toc-title-wrap">
          <span class="toc-icon" aria-hidden="true">📑</span>
          <span class="toc-title">Table of Contents</span>
          <span class="toc-count">({filteredHeadings.length} sections)</span>
        </span>
        <span class="toc-toggle-indicator" aria-hidden="true">▾</span>
      </summary>
      
      <ol class="toc-list">
        {filteredHeadings.map((h) => (
          <li class={`toc-item depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="toc-link">
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<style>
  .toc-container {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 10px 16px;
    margin: 20px 0 28px;
    font-family: var(--font-ui);
    transition: border-color 0.15s ease;
  }

  .toc-container:hover {
    border-color: var(--border);
  }

  .toc-details summary {
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    outline: none;
    list-style: none;
  }

  .toc-details summary::-webkit-details-marker {
    display: none;
  }

  .toc-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toc-icon {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .toc-title {
    color: var(--text-primary);
  }

  .toc-details summary:focus-visible {
    color: var(--accent);
  }

  .toc-count {
    font-size: 0.72rem;
    font-weight: normal;
    color: var(--text-muted);
  }

  .toc-toggle-indicator {
    font-size: 0.75rem;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }

  .toc-details:not([open]) .toc-toggle-indicator {
    transform: rotate(-90deg);
  }

  .toc-list {
    list-style: none;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border-subtle);
  }

  .toc-item {
    margin: 5px 0;
    line-height: 1.35;
  }

  .toc-item.depth-2 {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .toc-item.depth-3 {
    font-size: 0.78rem;
    padding-left: 14px;
    color: var(--text-secondary);
  }

  .toc-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc-link:hover, .toc-link:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

<script is:inline>
  // Collapse TOC on mobile viewports (<768px) to reduce initial scroll fatigue
  document.addEventListener('DOMContentLoaded', () => {
    if (window.innerWidth < 768) {
      const toc = document.getElementById('toc-details');
      if (toc) toc.removeAttribute('open');
    }
  });
</script>
